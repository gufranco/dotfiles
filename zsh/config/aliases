#!/usr/bin/env bash

__alias_if_exists mkdir mkdir "command mkdir -p -v"
__alias_if_exists neomutt mutt "command neomutt"
__alias_if_exists tty-clock tty-clock "command tty-clock -Dcs"
__alias_if_exists find findf "command find . -type f -name"
__alias_if_exists find findd "command find . -type d -name"
__alias_if_exists bat cat "command bat"
__alias_if_exists btm top "command btm"
__alias_if_exists broot br "command broot"
__alias_if_exists ranger ra "command ranger"
__alias_if_exists newsboat news "command newsboat"
__alias_if_exists tig tg "command tig"
__alias_if_exists navi nv "command navi"
__alias_if_exists goaccess goa "command goaccess"
__alias_if_exists trrntzip torrentzip "command trrntzip"
__alias_if_exists python3 pdbg "python3 -m pdb"
__alias_if_exists node ni "node inspect"
__alias_if_exists node nib "node --inspect-brk"
__alias_if_exists node niw "node --inspect-wait"
__alias_if_exists node nw "node --watch"
__alias_if_exists node jsr "node $HOME/.dotfiles/nodejs/repl-init.mjs"

if command ls --color=auto / >/dev/null 2>&1; then
  alias ls="command ls --color=auto"
  alias la="command ls -lAF --color=auto"
  alias ll="command ls -lF --color=auto"
else
  alias ls="command ls -G"
  alias la="command ls -lAF -G"
  alias ll="command ls -lF -G"
fi

if command -v broot >/dev/null; then
  function b() {
    local outcmd cmd
    outcmd=$(mktemp "${TMPDIR:-/tmp}/broot-out.XXXXXX")
    if command broot --outcmd "$outcmd" "$@"; then
      cmd=$(<"$outcmd")
      rm -f "$outcmd"
      [ -n "$cmd" ] && eval "$cmd"
    else
      rm -f "$outcmd"
    fi
  }
fi

if command -v lazygit >/dev/null; then
  # shellcheck disable=SC2034
  __lazygit_widget() { BUFFER="lazygit"; zle accept-line; }
  zle -N __lazygit_widget
  bindkey '^g' __lazygit_widget
fi

if command -v opencode >/dev/null && command -v lms >/dev/null; then
  function oc() {
    curl -sf http://127.0.0.1:1234/v1/models >/dev/null 2>&1 || lms server start
    command opencode "$@"
  }
fi

if command grep --version >/dev/null 2>&1; then
  alias grep="command grep --color"
else
  alias grep="command grep -G"
fi
if command find --version >/dev/null 2>&1; then
  alias findx="command find . -type f -executable"
else
  alias findx="command find . -type f -perm +111"
fi
command time --version >/dev/null 2>&1 && alias time="command time -v"
command which --version >/dev/null 2>&1 && alias which="command which -a"
command -v md5sum >/dev/null || alias md5sum="command md5"
command -v sha1sum >/dev/null || alias sha1sum="command shasum"
command -v sha256sum >/dev/null || alias sha256sum="command shasum -a 256"
command -v sha512sum >/dev/null || alias sha512sum="command shasum -a 512"
if ! readlink -f / >/dev/null 2>&1; then
  __alias_if_exists realpath readlink "command realpath"
  command -v realpath >/dev/null || __alias_if_exists greadlink readlink "command greadlink"
fi
__alias_if_exists tokei stats "command tokei"
__alias_if_exists gping ping "command gping"

if command -v fzf >/dev/null; then
  function fkill() {
    local pids
    pids="$(command ps -ef | sed 1d | fzf -m --header='kill a process' | awk '{ print $2 }')"
    [ -n "$pids" ] || return
    echo "$pids" | xargs kill -"${1:-9}"
  }

  function portkill() {
    local pids
    pids="$(command lsof -Pwni tcp | sed 1d | fzf -m --header='kill what listens on a port' | awk '{ print $2 }')"
    [ -n "$pids" ] || return
    echo "$pids" | xargs kill -"${1:-9}"
  }

  function fco() {
    command git rev-parse HEAD >/dev/null 2>&1 || return
    local tags branches target
    tags="$(command git tag | awk '{ print "tag\t" $1 }')"
    branches="$(command git branch --all |
      command grep -v HEAD |
      sed 's/.* //; s#remotes/[^/]*/##' |
      sort -u |
      awk '{ print "branch\t" $1 }')"
    target="$( (
      echo "$tags"
      echo "$branches"
    ) | sed '/^$/d' | fzf --no-hscroll --reverse +m -d '\t' -n 2)"
    [ -n "$target" ] || return
    command git checkout "$(echo "$target" | awk '{ print $2 }')"
  }

  function fssh() {
    local host
    host="$(command grep -w '^Host' "$HOME/.dotfiles/ssh/config" 2>/dev/null |
      awk '{ print $2 }' |
      command grep -v '[*?]' |
      fzf --header='ssh to a host')"
    [ -n "$host" ] || return
    command ssh "$host"
  }
fi

if command -v curl >/dev/null; then
  function cheat() {
    command curl -s "cheat.sh/$1"
  }
fi
