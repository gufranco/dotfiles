#!/usr/bin/env bash

__NDS_RSA_SIZE=136
__NDS_RSA_MAGIC="6163"
__NDS_LOGO_CRC_EXPECT=53078
__NDS_HEADER_MIN=532

function __nds_trim_help() {
  cat <<'HELP'
nds-trim - remove the padding from Nintendo DS and DSi ROM files

usage:
  nds-trim [options] <file.nds>...    trim each file in place
  nds-trim help                       print this page

options:
  --dry-run          show what would be trimmed, change nothing
  --info             print each ROM's header, change nothing
  --verify           refuse to trim when the padding holds anything but 00 or FF
  --backup           keep a copy of each file as <file>.bak before trimming
  --recursive, -r    take directories and trim every .nds file inside them

notes:
  It follows the GodMode9 trim: a DS ROM keeps its download-play RSA
  certificate when it has one, and a DSi-enhanced ROM keeps its DSi area.
  A file whose logo or header checksum is wrong is skipped untouched.

examples:
  nds-trim --dry-run *.nds
  nds-trim --backup --verify game.nds
  nds-trim -r ~/roms/nds
HELP
}

function __nds_trim_file_size() {
  command stat -c%s "$1" 2>/dev/null || command stat -f%z "$1"
}

function __nds_trim_read_hex() {
  xxd -s "$2" -l "$3" -p "$1"
}

function __nds_trim_read_u32le() {
  local hex
  hex="$(__nds_trim_read_hex "$1" "$2" 4)"
  printf '%d' "$((16#${hex:6:2}${hex:4:2}${hex:2:2}${hex:0:2}))"
}

function __nds_trim_read_u16le() {
  local hex
  hex="$(__nds_trim_read_hex "$1" "$2" 2)"
  printf '%d' "$((16#${hex:2:2}${hex:0:2}))"
}

function __nds_trim_read_ascii() {
  __nds_trim_read_hex "$1" "$2" "$3" | sed 's/00//g' | xxd -r -p
}

function __nds_trim_crc16() {
  od -A n -v -t u1 -j "$2" -N "$3" "$1" | awk '
    function xor16(a, b,    result, bit, p) {
      result = 0; bit = 1
      for (p = 0; p < 16; p++) {
        if ((int(a / bit) % 2) != (int(b / bit) % 2)) result += bit
        bit *= 2
      }
      return result
    }
    BEGIN { crc = 65535; poly = 40961 }
    {
      for (i = 1; i <= NF; i++) {
        crc = xor16(crc, int($i))
        for (b = 0; b < 8; b++) {
          carry = crc % 2
          crc = int(crc / 2)
          if (carry) crc = xor16(crc, poly)
        }
      }
    }
    END { printf "%d\n", crc }'
}

function __nds_trim_format_size() {
  awk -v bytes="$1" 'BEGIN {
    if (bytes >= 1073741824) printf "%.1f GB", bytes / 1073741824
    else if (bytes >= 1048576) printf "%.1f MB", bytes / 1048576
    else if (bytes >= 1024) printf "%.1f KB", bytes / 1024
    else printf "%d B", bytes
  }'
}

function __nds_trim_unitcode_label() {
  case "$1" in
    0) echo "NTR" ;;
    2) echo "NTR+TWL, DSi enhanced" ;;
    3) echo "TWL, DSi only" ;;
    *) echo "unknown ($1)" ;;
  esac
}

function __nds_trim_header_ok() {
  local file="$1"
  local name="${file##*/}"

  if [ "$(__nds_trim_file_size "$file")" -lt "$__NDS_HEADER_MIN" ]; then
    __warn nds-trim "${name} is too small to hold a DS header, skipped."
    return 1
  fi
  if [ "$(__nds_trim_crc16 "$file" 192 156)" -ne "$__NDS_LOGO_CRC_EXPECT" ]; then
    __warn nds-trim "${name} has a bad logo checksum and is not a DS ROM, skipped."
    return 1
  fi
  if [ "$(__nds_trim_crc16 "$file" 0 350)" -ne "$(__nds_trim_read_u16le "$file" 0x15E)" ]; then
    __warn nds-trim "${name} has a bad header checksum, skipped."
    return 1
  fi
}

function __nds_trim_target() {
  local file="$1"
  local actual="$2"
  local unitcode ntr_size twl_size

  unitcode=$((16#$(__nds_trim_read_hex "$file" 0x12 1)))
  ntr_size="$(__nds_trim_read_u32le "$file" 0x80)"
  [ "$ntr_size" -gt 0 ] || return 1
  if [ "$unitcode" -ne 0 ]; then
    twl_size="$(__nds_trim_read_u32le "$file" 0x210)"
    [ "$twl_size" -gt 0 ] || return 1
    printf '%s dsi %s\n' "$twl_size" "$unitcode"
  elif [ "$ntr_size" -lt "$actual" ] && [ "$(__nds_trim_read_hex "$file" "$ntr_size" 2)" = "$__NDS_RSA_MAGIC" ]; then
    printf '%s rsa %s\n' "$((ntr_size + __NDS_RSA_SIZE))" "$unitcode"
  else
    printf '%s plain %s\n' "$ntr_size" "$unitcode"
  fi
}

function __nds_trim_info() {
  local file="$1"
  local actual="$2"
  local trim_size="$3"
  local kind="$4"
  local unitcode="$5"

  printf '%-11s %s, %s\n' "File:" "${file##*/}" "$(__nds_trim_format_size "$actual")"
  printf '%-11s %s\n' "Title:" "$(__nds_trim_read_ascii "$file" 0x00 12)"
  printf '%-11s %s\n' "Game code:" "$(__nds_trim_read_ascii "$file" 0x0C 4)"
  printf '%-11s 0x%02x, %s\n' "Unit code:" "$unitcode" "$(__nds_trim_unitcode_label "$unitcode")"
  printf '%-11s %s\n' "RSA cert:" "$([ "$kind" = rsa ] && echo "yes, download play" || echo no)"
  printf '%-11s %s\n' "Trim size:" "$(__nds_trim_format_size "$trim_size")"
  printf '%-11s %s\n\n' "Padding:" "$(__nds_trim_format_size "$((actual - trim_size))")"
}

function __nds_trim_padding_clean() {
  local offset
  offset="$(od -A d -t x1 -j "$2" "$1" | awk '{
    for (i = 2; i <= NF; i++) if ($i != "00" && $i != "ff") { print $1 + (i - 2); exit }
  }')"
  [ -z "$offset" ] && return 0
  __warn nds-trim "${1##*/} holds data at offset ${offset} past the trim point, skipped."
  return 1
}

function __nds_trim_apply() {
  local file="$1"
  local trim_size="$2"

  if [ "$__nds_backup" = 1 ]; then
    if [ -e "${file}.bak" ]; then
      __warn nds-trim "${file##*/}.bak already exists, skipped."
      return 1
    fi
    cp "$file" "${file}.bak" || return 1
  fi
  truncate -s "$trim_size" "$file"
}

function __nds_trim_one() {
  local file="$1"
  local actual trim_size kind unitcode before after

  [ -f "$file" ] || { __error nds-trim "${file} does not exist."; return 1; }
  __nds_trim_header_ok "$file" || return 1
  actual="$(__nds_trim_file_size "$file")"
  read -r trim_size kind unitcode <<<"$(__nds_trim_target "$file" "$actual")"
  [ -n "$trim_size" ] || { __warn nds-trim "${file##*/} declares a ROM size of 0, skipped."; return 1; }
  [ "$__nds_info" = 1 ] && { __nds_trim_info "$file" "$actual" "$trim_size" "$kind" "$unitcode"; return 0; }
  [ "$trim_size" -le "$actual" ] || { __warn nds-trim "${file##*/} is shorter than its header says, skipped."; return 1; }
  [ "$trim_size" -lt "$actual" ] || return 0
  [ "$__nds_verify" = 1 ] && { __nds_trim_padding_clean "$file" "$trim_size" || return 1; }
  before="$(__nds_trim_format_size "$actual")"
  after="$(__nds_trim_format_size "$trim_size")"
  if [ "$__nds_dry_run" = 1 ]; then
    __say "Would trim ${file##*/}, ${kind}: ${before} to ${after}."
    return 0
  fi
  __nds_trim_apply "$file" "$trim_size"
}

function __nds_trim_files() {
  local item
  for item in "$@"; do
    if [ "$__nds_recursive" = 1 ] && [ -d "$item" ]; then
      command find "$item" -type f -iname '*.nds'
    else
      printf '%s\n' "$item"
    fi
  done
}

function nds-trim() {
  local __nds_dry_run=0 __nds_verify=0 __nds_backup=0 __nds_info=0 __nds_recursive=0
  local -a files=()
  local file failed=0

  while [ $# -gt 0 ]; do
    case "$1" in
      help | -h | --help) __nds_trim_help; return 0 ;;
      --dry-run) __nds_dry_run=1 ;;
      --verify) __nds_verify=1 ;;
      --backup) __nds_backup=1 ;;
      --info) __nds_info=1 ;;
      -r | --recursive) __nds_recursive=1 ;;
      --) shift; files+=("$@"); break ;;
      -*) __usage_error nds-trim "unknown option '$1'"; return 1 ;;
      *) files+=("$1") ;;
    esac
    shift
  done
  [ "${#files[@]}" -gt 0 ] || { __usage_error nds-trim "no file given"; return 1; }
  while IFS= read -r file; do
    __nds_trim_one "$file" || failed=$((failed + 1))
  done < <(__nds_trim_files "${files[@]}")
  [ "$failed" -eq 0 ]
}
