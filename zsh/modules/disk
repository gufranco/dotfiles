#!/usr/bin/env bash

################################################################################
# Wipe a storage device with write+verify passes
################################################################################
function disk_wipe() {
  __dw_validate_params() {
    local disk="$1"
    local passes="$2"

    if ! [[ "$passes" =~ ^[0-9]+$ ]] || [ "$passes" -lt 1 ]; then
      __log_error "Invalid PASSES value: $passes (must be a positive integer)"
      return 1
    fi

    if [ -z "$disk" ]; then
      __log_error "No device specified"
      __log_info "Usage: disk_wipe <device|mount_point>"
      __log_info "       disk_wipe /dev/disk4"
      __log_info "       disk_wipe /Volumes/USB"
      __log_info "       PASSES=N disk_wipe <device|mount_point>"
      __log_info "       CREATE=y disk_wipe <device|mount_point>"
      return 1
    fi

    if [ ! -b "$disk" ] && [ ! -c "$disk" ]; then
      __log_error "Device not found or invalid: $disk"
      return 1
    fi

    return 0
  }

  __dw_confirm() {
    local disk="$1"
    local confirm

    printf "This will ERASE all data on %s. Continue? (y/N): " "$disk"
    IFS= read -r confirm

    if [ "$confirm" != "y" ]; then
      __log_warning "Operation cancelled"
      return 1
    fi

    return 0
  }

  __dw_now_ms() {
    if [ -n "${EPOCHREALTIME:-}" ]; then
      printf '%s\n' "$EPOCHREALTIME" |
        awk -F'[.,]' '{ printf "%d\n", ($1 * 1000) + substr($2 "000", 1, 3) }'
    elif __cmd_exists perl; then
      perl -MTime::HiRes=time -e 'printf "%d\n", time() * 1000'
    else
      echo $(($(date +%s) * 1000))
    fi
  }

  __dw_bounded() {
    local seconds="$1"
    shift

    if __cmd_exists timeout; then
      timeout "$seconds" "$@"
      return $?
    fi

    if __cmd_exists gtimeout; then
      gtimeout "$seconds" "$@"
      return $?
    fi

    "$@" &
    local pid=$!
    local waited=0

    while sudo -n kill -0 "$pid" 2>/dev/null; do
      if [ "$waited" -ge "$seconds" ]; then
        sudo -n kill -TERM "$pid" 2>/dev/null
        sleep 1
        sudo -n kill -KILL "$pid" 2>/dev/null
        wait "$pid" 2>/dev/null
        return 124
      fi
      sleep 1
      waited=$((waited + 1))
    done

    wait "$pid"
  }

  __dw_bounded_ms() {
    local ms="$1"
    shift

    local runner=""
    if __cmd_exists timeout; then
      runner="timeout"
    elif __cmd_exists gtimeout; then
      runner="gtimeout"
    fi

    if [ -n "$runner" ]; then
      "$runner" -k 2 "$(printf '%d.%03d' $((ms / 1000)) $((ms % 1000)))" "$@"
      return $?
    fi

    local seconds=$(((ms + 999) / 1000))
    [ "$seconds" -lt 1 ] && seconds=1
    __dw_bounded "$seconds" "$@"
  }

  __dw_is_mounted() {
    mount | awk -v dev="$1" '$1 == dev || index($1, dev "s") == 1 { found = 1 } END { exit found ? 0 : 1 }'
  }

  __dw_release_darwin() {
    local disk="$1"

    __dw_bounded 30 sudo diskutil unmountDisk force "$disk" >/dev/null 2>&1

    if ! __dw_is_mounted "$disk"; then
      return 0
    fi

    local slice
    for slice in $(diskutil list "$disk" 2>/dev/null | awk '$NF ~ /^disk[0-9]+s[0-9]+$/ { print $NF }'); do
      __dw_bounded 20 sudo diskutil unmount force "/dev/$slice" >/dev/null 2>&1
    done

    __dw_is_mounted "$disk" && return 1
    return 0
  }

  __dw_io_device() {
    local disk="$1"
    local name="${disk##*/}"

    if [ "$(uname)" = "Darwin" ] && [ "${name#r}" = "$name" ] && [ -c "/dev/r$name" ]; then
      printf '/dev/r%s\n' "$name"
      return 0
    fi

    printf '%s\n' "$disk"
  }

  __dw_device_identity() {
    local disk="$1"
    local vendor="" model="" name

    case "$(uname)" in
      Darwin)
        model=$(diskutil info -plist "$disk" 2>/dev/null |
          plutil -extract MediaName raw - 2>/dev/null)
        ;;
      Linux)
        name="${disk##*/}"
        vendor=$(cat "/sys/block/$name/device/vendor" 2>/dev/null)
        model=$(cat "/sys/block/$name/device/model" 2>/dev/null)
        if [ -z "$vendor" ] && [ -z "$model" ]; then
          vendor=$(lsblk -dno VENDOR "$disk" 2>/dev/null | head -1)
          model=$(lsblk -dno MODEL "$disk" 2>/dev/null | head -1)
        fi
        ;;
    esac

    printf '%s %s\n' "$vendor" "$model" |
      tr '[:lower:]' '[:upper:]' | tr -s '[:space:]' ' ' | sed 's/^ //; s/ *$//'
  }

  __dw_device_family() {
    case "$1" in
      *"ZIP 100"* | *"ZIP 250"* | *"ZIP 750"* | *ZIP100* | *ZIP250* | *ZIP750*)
        echo "zip"
        ;;
      *"LS-120"* | *"LS-240"* | *SUPERDISK*)
        echo "superdisk"
        ;;
      *"JAZ "* | *JAZ1GB* | *JAZ2GB*)
        echo "jaz"
        ;;
      *"USB-FDU"* | *"FD-05"* | *"USB FDD"* | *FLOPPY*)
        echo "floppy"
        ;;
      *"POCKETZIP"* | *"CLIK!"*)
        echo "pocketzip"
        ;;
      *)
        echo ""
        ;;
    esac
  }

  __dw_fragile() {
    case "$__DW_FAMILY" in
      zip | jaz | pocketzip | floppy | superdisk) return 0 ;;
      *) return 1 ;;
    esac
  }

  __dw_head_crash_family() {
    case "$__DW_FAMILY" in
      zip | jaz | pocketzip) return 0 ;;
      *) return 1 ;;
    esac
  }

  __dw_error_class() {
    case "$1" in
      *"Device not configured"* | *"No such device"* | *"No such file or directory"* | \
        *"Operation not permitted"* | *"No medium found"* | *"not ready"* | *"Not ready"* | \
        *ENXIO* | *ENODEV*)
        echo "bus"
        ;;
      *"Input/output error"* | *"I/O error"* | *EIO* | *"Media error"* | *"medium error"*)
        echo "media"
        ;;
      *)
        echo "other"
        ;;
    esac
  }

  __dw_device_gone() {
    local disk="$1"
    local name="${disk##*/}"

    [ -b "$disk" ] || [ -c "$disk" ] || return 0

    case "$(uname)" in
      Darwin)
        [ -c "/dev/r$name" ] || return 0
        __dw_bounded 10 diskutil info "$disk" >/dev/null 2>&1 || return 0
        ;;
      Linux)
        __dw_bounded 10 sudo blockdev --getsize64 "$disk" >/dev/null 2>&1 || return 0
        ;;
    esac

    return 1
  }

  __dw_sector_bytes() {
    local disk="$1"
    local bytes=""

    case "$(uname)" in
      Darwin)
        bytes=$(diskutil info "$disk" 2>/dev/null |
          awk -F': +' '/Device Block Size/ { print $2 }' | awk '{ print $1 }')
        ;;
      Linux)
        bytes=$(sudo blockdev --getss "$disk" 2>/dev/null)
        ;;
    esac

    if ! [[ "$bytes" =~ ^[0-9]+$ ]] || [ "$bytes" -lt 512 ]; then
      bytes=512
    fi

    echo "$bytes"
  }

  __dw_writable_media() {
    local disk="$1"
    local answer

    case "$(uname)" in
      Darwin)
        answer=$(diskutil info -plist "$disk" 2>/dev/null |
          plutil -extract WritableMedia raw - 2>/dev/null)
        case "$answer" in
          false) return 1 ;;
          true) return 0 ;;
        esac
        ;;
      Linux)
        answer=$(sudo blockdev --getro "$disk" 2>/dev/null)
        case "$answer" in
          1) return 1 ;;
          0) return 0 ;;
        esac
        ;;
    esac

    return 2
  }

  __dw_writes_land() {
    local disk="$1"
    local io sector probe readback octal
    io=$(__dw_io_device "$disk")
    sector="$__DW_SECTOR"
    probe="${__DW_TMPDIR}/write-probe"
    readback="${__DW_TMPDIR}/write-probe-back"

    for octal in '\252' '\125'; do
      head -c "$sector" /dev/zero | tr '\000' "$octal" >"$probe" || return 2
      [ "$(__dw_file_size "$probe")" -eq "$sector" ] || return 2

      __dw_move write "$probe" "$io" 0 "$sector" || return 2
      [ "$__DW_MOVED" -eq "$sector" ] || return 2
      sync

      __dw_move read "$io" "$readback" 0 "$sector" || return 2
      [ "$__DW_MOVED" -eq "$sector" ] || return 2

      cmp -s "$probe" "$readback" || return 1
    done

    return 0
  }

  __dw_report_write_protected() {
    local disk="$1"
    local evidence="$2"

    __log_error "STOPPED: $disk is write protected, so nothing on it can be erased."
    case "$evidence" in
      flag) __log_error "The drive reports this media as read-only." ;;
      silent) __log_error "The drive accepted a test write and the media kept its previous contents." ;;
    esac

    __dw_write_protect_advice
    return 0
  }

  __dw_write_protect_advice() {
    case "$__DW_FAMILY" in
      floppy | superdisk)
        __log_info "Cover the square hole on the corner of the disk by sliding its tab shut, then run this again."
        ;;
      zip | jaz | pocketzip)
        __log_info "Unlock the cartridge, through the Iomega tools or its write-protect tab, then run this again."
        ;;
      *)
        __log_info "Release the write-protect switch or lock on the device, then run this again."
        ;;
    esac

    return 0
  }

  __dw_probe_cache_bypass() {
    local device="$1"
    local sector="$2"

    __DW_READ_FLAGS=""
    __DW_WRITE_FLAGS=""
    __DW_FLUSH=0

    if [ "$(uname)" != "Linux" ]; then
      return 0
    fi

    if sudo dd if="$device" bs="$sector" count=1 iflag=direct status=none >/dev/null 2>&1; then
      __DW_READ_FLAGS="iflag=direct"
      __DW_WRITE_FLAGS="oflag=direct"
      __log_info "Bypassing the page cache so every chunk reaches the media."
    else
      __DW_FLUSH=1
      __log_info "Direct I/O is unavailable, so buffers are dropped before every verify."
    fi
  }

  __dw_pattern_file() {
    local size="$1"
    local pattern="$2"
    local target="${__DW_TMPDIR}/pattern-${pattern}"

    if [ ! -f "$target" ] || [ "$(__dw_file_size "$target")" -ne "$size" ]; then
      if [ "$pattern" = "0xFF" ]; then
        head -c "$size" /dev/zero | tr '\000' '\377' >"$target" || return 1
      else
        head -c "$size" /dev/zero >"$target" || return 1
      fi
    fi

    if [ "$(__dw_file_size "$target")" -ne "$size" ]; then
      return 1
    fi

    printf '%s\n' "$target"
  }

  __dw_file_size() {
    local bytes

    bytes=$(wc -c <"$1" 2>/dev/null | tr -d '[:space:]')
    if [ -z "$bytes" ]; then
      bytes=0
    fi

    echo "$bytes"
  }

  __dw_duration() {
    local ms="$1"

    if [ "$ms" -lt 1000 ]; then
      printf '%sms\n' "$ms"
    else
      printf '%ss\n' "$((ms / 1000))"
    fi
  }

  __dw_dd_bytes() {
    awk '/bytes/ { print $1; exit }' "$1"
  }

  __dw_dd_error() {
    grep -v -E 'records (in|out)|bytes' "$1" 2>/dev/null |
      sed '/^[[:space:]]*$/d' | tail -2 | tr '\n' ' ' | sed 's/ *$//'
  }

  __dw_set_error() {
    __DW_LAST_ERROR="$1"
    [ -n "${__DW_ERRFILE:-}" ] && printf '%s\n' "$1" >"$__DW_ERRFILE"
    return 0
  }

  __dw_get_error() {
    if [ -n "${__DW_ERRFILE:-}" ] && [ -s "$__DW_ERRFILE" ]; then
      tr -d '\n' <"$__DW_ERRFILE"
      return 0
    fi

    printf '%s' "${__DW_LAST_ERROR:-}"
  }

  __dw_report_failure() {
    local detail
    detail=$(__dw_get_error)
    __DW_LAST_DETAIL="$detail"

    __log_error "$1"
    if [ -n "$detail" ]; then
      __log_error "dd said: $detail"
      __dw_set_error ""
    fi
  }

  __dw_median() {
    sort -n | awk '
      { value[NR] = $1 }
      END {
        if (NR == 0) { print 0; exit }
        if (NR % 2) { print value[(NR + 1) / 2]; exit }
        print int((value[NR / 2] + value[NR / 2 + 1]) / 2)
      }
    '
  }

  __dw_expected_ms() {
    local kind="$1"
    local bytes="$2"
    local overhead rate

    if [ "$kind" = "write" ]; then
      overhead="$__DW_OVERHEAD_WRITE"
      rate="$__DW_RATE_WRITE"
    else
      overhead="$__DW_OVERHEAD_READ"
      rate="$__DW_RATE_READ"
    fi

    if [ "${rate:-0}" -le 0 ]; then
      echo 0
      return 0
    fi

    echo $((overhead + (bytes * 1000) / rate))
  }

  __dw_time_move() {
    local direction="$1"
    local io="$2"
    local offset="$3"
    local bytes="$4"
    local source target started elapsed

    if [ "$direction" = "write" ]; then
      if ! source=$(__dw_pattern_file "$bytes" "0x00"); then
        return 1
      fi
      target="$io"
    else
      source="$io"
      target="${__DW_TMPDIR}/calibration"
    fi

    if [ "$direction" != "write" ] && [ "$__DW_FLUSH" = "1" ]; then
      sync
      sudo blockdev --flushbufs "$io" 2>/dev/null
    fi

    started=$(__dw_now_ms)
    __dw_move "$direction" "$source" "$target" "$offset" "$bytes" || return 1
    elapsed=$(($(__dw_now_ms) - started))

    [ "$__DW_MOVED" -eq "$bytes" ] || return 1
    if [ "$elapsed" -lt 0 ]; then
      __dw_set_error "the clock went backwards while timing $bytes bytes"
      return 1
    fi

    if __dw_fragile && [ "$elapsed" -gt "$__DW_PROBE_CEILING" ]; then
      __dw_set_error "a $bytes byte $direction took $(__dw_duration "$elapsed"), which is a drive retrying a seek rather than reading"
      return 1
    fi

    echo "$elapsed"
  }

  __dw_quietest_move() {
    local direction="$1"
    local io="$2"
    local offset="$3"
    local bytes="$4"
    local attempt=0
    local repeats="$__DW_REPEATS"
    local elapsed quietest=""

    while [ "$attempt" -lt "$repeats" ]; do
      elapsed=$(__dw_time_move "$direction" "$io" "$offset" "$bytes") || return 1
      if [ -z "$quietest" ] || [ "$elapsed" -lt "$quietest" ]; then
        quietest="$elapsed"
      fi
      attempt=$((attempt + 1))
    done

    echo "$quietest"
  }

  __dw_probe_bytes() {
    local direction="$1"
    local io="$2"
    local unit="$3"
    local ceiling="$4"
    local floor="${CALIBRATION_FLOOR_MS:-50}"
    local candidate elapsed

    candidate=$((64 * 1024))
    [ "$candidate" -lt $((unit * 2)) ] && candidate=$((unit * 2))
    [ "$candidate" -gt "$ceiling" ] && candidate="$ceiling"

    while [ "$candidate" -lt "$ceiling" ]; do
      elapsed=$(__dw_quietest_move "$direction" "$io" 0 "$candidate") || return 1
      [ "$elapsed" -ge "$floor" ] && break
      candidate=$((candidate * 2))
    done

    [ "$candidate" -gt "$ceiling" ] && candidate="$ceiling"
    echo "$candidate"
  }

  __dw_probe_verdict() {
    local direction="$1"
    local disk="$2"
    local class

    class=$(__dw_error_class "${__DW_LAST_DETAIL:-}")

    if [ "$class" = "bus" ] || __dw_device_gone "$disk"; then
      __log_error "$disk stopped answering the bus, so this is the drive or the cartridge, not the data."
      return 2
    fi

    if [ "$direction" = "write" ]; then
      return 2
    fi

    if __dw_fragile; then
      __log_error "A $__DW_FAMILY disk that cannot be read during a light probe is already failing."
      __log_error "Stopping here rather than seeking across it again."
      return 2
    fi

    __log_warning "That was a read of data this wipe is about to overwrite, so it does not decide anything."
    __log_warning "Continuing. The verify after each write is what judges the media."
    return 1
  }

  __dw_calibrate() {
    local direction="$1"
    local disk="$2"
    local size="$3"
    local probes="${CALIBRATION_PROBES:-$__DW_PROBES}"
    local io unit large room stride index offset short long overhead rate spread
    local predicted
    local overheads="${__DW_TMPDIR}/cal-overhead" rates="${__DW_TMPDIR}/cal-rate"
    local transfers="${__DW_TMPDIR}/cal-transfer"

    io=$(__dw_io_device "$disk")
    unit="$__DW_SECTOR"
    [ "$unit" -lt 4096 ] && unit=4096
    [ "$probes" -ge 1 ] || probes=1

    stride=$((size / probes))
    stride=$((stride - stride % unit))
    if [ "$stride" -lt $((unit * 4)) ]; then
      probes=1
      stride="$size"
    fi

    room=$((stride / 2))
    [ "$room" -gt $((16 * 1024 * 1024)) ] && room=$((16 * 1024 * 1024))
    room=$((room - room % unit))
    if [ "$room" -lt $((unit * 2)) ] || [ $((room + unit)) -gt "$size" ]; then
      __log_warning "$disk is too small to time, so only the byte-for-byte verify will judge it."
      return 1
    fi

    if ! large=$(__dw_probe_bytes "$direction" "$io" "$unit" "$room"); then
      __dw_report_failure "The $direction probe failed on the first sectors of $disk."
      __dw_probe_verdict "$direction" "$disk"
      return $?
    fi

    : >"$overheads"
    : >"$rates"
    : >"$transfers"

    index=0
    while [ "$index" -lt "$probes" ]; do
      offset=$((index * stride))
      [ $((offset + large + unit)) -gt "$size" ] && break

      if ! short=$(__dw_time_move "$direction" "$io" "$offset" "$unit"); then
        __dw_report_failure "The $direction probe failed at offset $offset of $disk."
        __dw_probe_verdict "$direction" "$disk"
        return $?
      fi
      if ! long=$(__dw_time_move "$direction" "$io" $((offset + unit)) "$large"); then
        __dw_report_failure "The $direction probe failed at offset $((offset + unit)) of $disk."
        __dw_probe_verdict "$direction" "$disk"
        return $?
      fi

      printf '%s\n' "$short" >>"$overheads"
      printf '%s\n' "$long" >>"$transfers"
      if [ "$long" -gt "$short" ]; then
        printf '%s\n' "$(((large - unit) * 1000 / (long - short)))" >>"$rates"
      fi

      index=$((index + 1))
    done

    overhead=$(__dw_median <"$overheads")
    rate=$(__dw_median <"$rates")

    if [ "${rate:-0}" -le 0 ]; then
      long=$(__dw_median <"$transfers")
      if [ "${long:-0}" -le 0 ]; then
        __log_warning "$disk answered too fast to time, so only the byte-for-byte verify will judge it."
        return 1
      fi
      overhead=0
      rate=$((large * 1000 / long))
      __log_info "Separating $direction overhead from throughput was not possible, so the whole probe sets the pace."
    fi

    predicted=$((overhead + (large * 1000) / rate))
    [ "$predicted" -lt 1 ] && predicted=1
    spread=$(($(sort -n "$transfers" | tail -1) * 100 / predicted))
    [ "$spread" -lt 100 ] && spread=100
    spread=$((spread * spread / 100))
    [ "$spread" -lt "$__DW_FACTOR_MIN" ] && spread="$__DW_FACTOR_MIN"
    [ "$spread" -gt "$__DW_FACTOR_MAX" ] && spread="$__DW_FACTOR_MAX"

    if [ -n "${SLOW_FACTOR:-}" ]; then
      spread=$((SLOW_FACTOR * 100))
    fi

    if [ "$direction" = "write" ]; then
      __DW_OVERHEAD_WRITE="$overhead"
      __DW_RATE_WRITE="$rate"
      __DW_FACTOR_WRITE="$spread"
    else
      __DW_OVERHEAD_READ="$overhead"
      __DW_RATE_READ="$rate"
      __DW_FACTOR_READ="$spread"
    fi

    __log_info "Measured $direction: $((rate / 1024)) KiB/s sustained, $(__dw_duration "$overhead") to reach a sector, allowing $((spread / 100))x that before stopping."
    return 0
  }

  __dw_chunk_bytes() {
    local size="$1"
    local target="${CHUNK_TARGET_MS:-$__DW_CHUNK_TARGET}"
    local unit="$__DW_SECTOR"
    local ceiling=$((64 * 1024 * 1024))
    local candidate best

    [ "$unit" -lt 4096 ] && unit=4096
    candidate="$unit"
    best="$unit"

    while [ "$candidate" -le "$ceiling" ] && [ "$candidate" -le "$size" ]; do
      if [ "$candidate" -gt "$unit" ] && [ "$(__dw_expected_ms write "$candidate")" -gt "$target" ]; then
        break
      fi
      best="$candidate"
      candidate=$((candidate * 2))
    done

    [ "$best" -gt "$size" ] && best="$size"
    echo "$best"
  }

  __dw_fault() {
    local disk="$1"
    local reason="$2"
    local kind="${3:-}"

    local detail class gone=0
    detail=$(__dw_get_error)
    [ -z "$detail" ] && detail="${__DW_LAST_DETAIL:-}"
    class=$(__dw_error_class "$detail")

    __log_error "STOPPED: $reason"
    if [ -n "$detail" ]; then
      __log_error "dd said: $detail"
    fi

    case "$detail" in
      *[Rr]ead-only* | *"Permission denied"* | *EROFS*)
        __log_error "That reads as write protection rather than worn media."
        __dw_write_protect_advice
        ;;
    esac

    __dw_device_gone "$disk" && gone=1

    if [ "$gone" -eq 1 ]; then
      __log_error "$disk is no longer on the bus, so there is nothing left to eject by software."
    else
      __log_error "Ejecting immediately rather than continuing."
      __dw_bounded 20 sync >/dev/null 2>&1
      __dw_eject_now "$disk"
    fi

    __dw_head_crash_advice "$gone" "$class" "$kind"
    __DW_LAST_DETAIL=""
    return 1
  }

  __dw_eject_now() {
    local disk="$1"

    case "$(uname)" in
      Darwin)
        if __dw_bounded 30 sudo diskutil eject "$disk" >/dev/null 2>&1; then
          __log_success "Cartridge ejected."
          return 0
        fi
        if __dw_bounded 20 sudo diskutil unmountDisk force "$disk" >/dev/null 2>&1; then
          __log_warning "The drive refused to eject. The volume is unmounted, so nothing else will touch it."
        else
          __log_error "The drive answered neither eject nor unmount within the time allowed."
        fi
        ;;
      Linux)
        if __dw_bounded 30 sudo eject "$disk" >/dev/null 2>&1; then
          __log_success "Cartridge ejected."
          return 0
        fi
        __log_error "The drive did not eject within the time allowed."
        ;;
    esac

    __log_error "Cut power to the drive before doing anything else with it. Do not press eject repeatedly."
    return 1
  }

  __dw_head_crash_advice() {
    local gone="$1"
    local class="$2"
    local kind="${3:-}"

    if [ "$kind" = "stall" ]; then
      __log_error "The drive stopped answering mid-transfer, which is a head retrying a seek, not slow data."
    fi

    if [ "$gone" -eq 1 ]; then
      __log_error "The drive dropped off the bus mid-operation, which is a hardware fault, not bad data."
    fi

    if __dw_head_crash_family &&
      { [ "$gone" -eq 1 ] || [ "$class" != "other" ] || [ -n "$kind" ]; }; then
      __log_error "On a $__DW_FAMILY drive this is the click of death: the head is out of alignment."
      __log_error "The drive will damage every cartridge you insert next, and this cartridge will damage every drive."
      __log_error "Retire both. Do not test this cartridge in a working drive to confirm."
      __log_error "One stall is the whole verdict. There is no reading it again to be sure."
      return 0
    fi

    __log_error "A drive that fails this way can damage the next media it is given."
    return 0
  }

  __dw_budget_ms() {
    local kind="$1"
    local bytes="$2"
    local expected factor slack drift baseline budget

    if [ "$__DW_MEASURED" != "1" ] || [ "$bytes" -le 0 ]; then
      echo 0
      return 0
    fi

    expected=$(__dw_expected_ms "$kind" "$bytes")
    [ "$expected" -lt 1 ] && expected=1

    if [ "$kind" = "write" ]; then
      factor="$__DW_FACTOR_WRITE"
      drift="$__DW_DRIFT_WRITE"
      slack=$((__DW_OVERHEAD_WRITE * __DW_SLACK))
    else
      factor="$__DW_FACTOR_READ"
      drift="$__DW_DRIFT_READ"
      slack=$((__DW_OVERHEAD_READ * __DW_SLACK))
    fi

    [ "$drift" -lt 100 ] && drift=100
    baseline=$((expected * drift / 100))
    budget=$((baseline * factor / 100))
    [ "$budget" -lt $((baseline + slack)) ] && budget=$((baseline + slack))

    echo "$budget"
  }

  __dw_idle_deadline() {
    if __dw_fragile; then
      echo "$__DW_PROBE_CEILING"
    else
      echo "$__DW_DEADLINE_CAP"
    fi
  }

  __dw_deadline_ms() {
    local kind="$1"
    local bytes="$2"
    local budget

    budget=$(__dw_budget_ms "$kind" "$bytes")
    [ "${budget:-0}" -le 0 ] && budget="$__DW_DEADLINE_CAP"
    [ "$budget" -lt 2000 ] && budget=2000
    [ "$budget" -gt "$__DW_DEADLINE_CAP" ] && budget="$__DW_DEADLINE_CAP"

    echo "$budget"
  }

  __dw_watch() {
    local kind="$1"
    local label="$2"
    local index="$3"
    local total="$4"
    local bytes="$5"
    local elapsed="$6"
    local ceiling=$((${STALL_SECONDS:-0} * 1000))
    local expected factor drift budget ratio

    __DW_REASON=""

    if [ "$ceiling" -gt 0 ] && [ "$elapsed" -gt "$ceiling" ]; then
      __DW_REASON="$label chunk $index of $total took $(__dw_duration "$elapsed"), over the $(__dw_duration "$ceiling") limit you set"
      return 1
    fi

    [ "$__DW_MEASURED" = "1" ] || return 0
    [ "$bytes" -le 0 ] && return 0

    expected=$(__dw_expected_ms "$kind" "$bytes")
    [ "$expected" -lt 1 ] && expected=1

    if [ "$kind" = "write" ]; then
      factor="$__DW_FACTOR_WRITE"
      drift="$__DW_DRIFT_WRITE"
    else
      factor="$__DW_FACTOR_READ"
      drift="$__DW_DRIFT_READ"
    fi

    [ "$drift" -lt 100 ] && drift=100
    budget=$(__dw_budget_ms "$kind" "$bytes")

    if [ "$budget" -gt 0 ] && [ "$elapsed" -gt "$budget" ]; then
      __DW_REASON="$label chunk $index of $total took $(__dw_duration "$elapsed") against $(__dw_duration "$budget") allowed by what this disk measured"
      return 1
    fi

    ratio=$((elapsed * 100 / expected))
    [ "$ratio" -lt 1 ] && ratio=1
    drift=$(((drift * 3 + ratio) / 4))

    if [ "$drift" -gt "$factor" ]; then
      __DW_REASON="$label has settled at $((drift / 100))x the speed this disk measured on itself, which it held for the last chunks"
      return 1
    fi

    if [ "$kind" = "write" ]; then
      __DW_DRIFT_WRITE="$drift"
    else
      __DW_DRIFT_READ="$drift"
    fi

    return 0
  }

  __dw_block_bytes() {
    local offset="$1"
    local bytes="$2"
    local block=$((1024 * 1024))
    local floor="$__DW_SECTOR"

    [ "$floor" -ge 512 ] || floor=512
    if [ "${__DW_CEILING:-0}" -gt 0 ] && [ "$block" -gt "$__DW_CEILING" ]; then
      block="$__DW_CEILING"
    fi
    [ "$block" -lt "$floor" ] && block="$floor"

    while [ "$block" -gt "$floor" ]; do
      if [ $((offset % block)) -eq 0 ] && [ $((bytes % block)) -eq 0 ]; then
        echo "$block"
        return 0
      fi
      block=$((block / 2))
    done

    echo "$floor"
  }

  __dw_move() {
    local direction="$1"
    local source="$2"
    local target="$3"
    local offset="$4"
    local bytes="$5"
    local err="${__DW_TMPDIR}/dd.err"
    local block count deadline outcome
    local -a flags move_cmd

    block=$(__dw_block_bytes "$offset" "$bytes")
    count=$((bytes / block))
    __DW_MOVED=0
    __DW_TIMED_OUT=0
    __DW_INTERRUPTED=0

    __dw_set_error ""

    flags=()
    if [ "$direction" = "write" ]; then
      [ -n "$__DW_WRITE_FLAGS" ] && flags=("$__DW_WRITE_FLAGS")
      move_cmd=(sudo dd if="$source" of="$target" bs="$block" seek=$((offset / block))
        count="$count" conv=notrunc "${flags[@]}")
    else
      [ -n "$__DW_READ_FLAGS" ] && flags=("$__DW_READ_FLAGS")
      move_cmd=(sudo dd if="$source" of="$target" bs="$block" skip=$((offset / block))
        count="$count" "${flags[@]}")
    fi

    deadline="${__DW_DEADLINE:-0}"
    outcome=0
    if [ "$deadline" -gt 0 ]; then
      __dw_bounded_ms "$deadline" "${move_cmd[@]}" 2>"$err" || outcome=$?
    else
      "${move_cmd[@]}" 2>"$err" || outcome=$?
    fi

    case "$outcome" in
      0) ;;
      124 | 137)
        __DW_TIMED_OUT=1
        __dw_set_error "the drive did not finish a $bytes byte $direction at offset $offset within $(__dw_duration "$deadline")"
        return 1
        ;;
      130 | 143)
        __DW_INTERRUPTED=1
        __dw_set_error "the $direction at offset $offset was interrupted"
        return 1
        ;;
      *)
        __dw_set_error "$(__dw_dd_error "$err")"
        return 1
        ;;
    esac

    __DW_MOVED=$(__dw_dd_bytes "$err")
    [ -z "$__DW_MOVED" ] && __DW_MOVED=0

    if [ "$__DW_MOVED" -ne "$bytes" ]; then
      __dw_set_error "dd moved $__DW_MOVED of $bytes bytes at offset $offset with bs=$block"
    fi

    return 0
  }

  __dw_run_phase() {
    local direction="$1"
    local disk="$2"
    local size="$3"
    local pattern="$4"
    local io chunk total index offset piece started elapsed reference label kind
    local moved dropped stalled
    local attempts="${CHUNK_RETRIES:-$__DW_RETRIES}"
    local attempt settled marginal=0 class

    [ "$attempts" -ge 1 ] || attempts=1

    io=$(__dw_io_device "$disk")
    chunk="$__DW_CHUNK"
    total=$(((size + chunk - 1) / chunk))

    if ! reference=$(__dw_pattern_file "$chunk" "$pattern"); then
      __log_error "Unable to build the $pattern reference pattern"
      return 1
    fi

    if [ "$direction" = "write" ]; then
      label="write"
      kind="write"
      __log_info "Writing $pattern over $total chunks, timing every chunk"
    else
      label="read"
      kind="read"
      if [ "$__DW_FLUSH" = "1" ]; then
        sync
        sudo blockdev --flushbufs "$io" 2>/dev/null
      fi
      __log_info "Verifying $pattern over $total chunks, timing every chunk"
    fi

    index=0
    while [ "$index" -lt "$total" ]; do
      offset=$((index * chunk))
      piece=$((size - offset))
      [ "$piece" -gt "$chunk" ] && piece="$chunk"

      attempt=1
      settled=0
      dropped=0
      stalled=0
      __DW_DEADLINE=$(__dw_deadline_ms "$kind" "$piece")
      while [ "$attempt" -le "$attempts" ]; do
        started=$(__dw_now_ms)

        moved=1
        if [ "$direction" = "write" ]; then
          __dw_move write "$reference" "$io" "$offset" "$piece" || moved=0
        else
          __dw_move read "$io" "${__DW_TMPDIR}/readback" "$offset" "$piece" || moved=0
        fi

        if [ "$moved" -eq 0 ]; then
          if [ "${__DW_INTERRUPTED:-0}" -eq 1 ]; then
            __log_error "STOPPED: interrupted during $label chunk $((index + 1)) of $total."
            __log_error "Nothing else will be written. Ejecting so the head leaves the surface."
            __dw_eject_now "$disk"
            return 1
          fi
          if [ "${__DW_TIMED_OUT:-0}" -eq 1 ]; then
            stalled=1
            break
          fi
          class=$(__dw_error_class "$(__dw_get_error)")
          if [ "$class" = "bus" ]; then
            dropped=1
            break
          fi
          if [ "$class" = "media" ] && __dw_head_crash_family; then
            break
          fi
          attempt=$((attempt + 1))
          continue
        fi

        elapsed=$(($(__dw_now_ms) - started))

        if [ "$__DW_MOVED" -ne "$piece" ]; then
          __dw_set_error "chunk $((index + 1)) of $total moved $__DW_MOVED of $piece bytes"
          attempt=$((attempt + 1))
          continue
        fi

        if [ "$direction" = "read" ] &&
          ! cmp -s -n "$piece" "${__DW_TMPDIR}/readback" "$reference"; then
          __dw_set_error "chunk $((index + 1)) of $total did not read back as $pattern"
          attempt=$((attempt + 1))
          continue
        fi

        settled=1
        break
      done

      if [ "$settled" -ne 1 ]; then
        if [ "$stalled" -eq 1 ]; then
          __dw_fault "$disk" "$label chunk $((index + 1)) of $total went silent for $(__dw_duration "$__DW_DEADLINE") at offset $offset" stall
        elif [ "$dropped" -eq 1 ]; then
          __dw_fault "$disk" "$label chunk $((index + 1)) of $total stopped answering at offset $offset"
        elif __dw_head_crash_family; then
          __dw_fault "$disk" "$label chunk $((index + 1)) of $total did not come back clean at offset $offset" fatal
        else
          __dw_fault "$disk" "$label chunk $((index + 1)) of $total failed $attempts times at offset $offset"
        fi
        return 1
      fi

      if [ "$attempt" -gt 1 ]; then
        marginal=$((marginal + 1))
        __log_warning "$label chunk $((index + 1)) of $total needed $attempt attempts at offset $offset"
      fi

      if ! __dw_watch "$kind" "$label" "$((index + 1))" "$total" "$piece" "$elapsed"; then
        __dw_fault "$disk" "$__DW_REASON" stall
        return 1
      fi

      index=$((index + 1))
    done

    if [ "$direction" = "write" ]; then
      sync
      __log_success "Write $pattern completed"
    else
      __log_success "Verify $pattern completed"
    fi

    if [ "$marginal" -gt 0 ]; then
      __log_warning "$marginal of $total chunks only settled on a retry. This media is wearing out."
    fi

    __DW_DEADLINE=$(__dw_idle_deadline)

    return 0
  }

  __dw_execute_pass() {
    local disk="$1"
    local size="$2"
    local index="$3"
    local passes="$4"

    __log_info "Pass $index of $passes"

    __dw_run_phase write "$disk" "$size" "0xFF" || return 1
    __dw_run_phase read "$disk" "$size" "0xFF" || return 1
    __dw_run_phase write "$disk" "$size" "0x00" || return 1
    __dw_run_phase read "$disk" "$size" "0x00" || return 1

    __log_success "Pass $index/$passes completed"
    return 0
  }

  __dw_detect_media() {
    local disk="$1"
    local size="$2"

    local size_mb=$((size / 1024 / 1024))

    if [ "$size_mb" -le 3 ]; then
      echo "floppy"
      return 0
    fi

    if [ "$size_mb" -le 260 ]; then
      echo "zip"
      return 0
    fi

    local two_gb=$((2 * 1024))
    if [ "$size_mb" -le "$two_gb" ]; then
      echo "small"
      return 0
    fi

    local thirty_two_gb=$((32 * 1024))
    if [ "$size_mb" -le "$thirty_two_gb" ]; then
      echo "medium"
      return 0
    fi

    echo "large"
  }

  __dw_create_partition() {
    local disk="$1"
    local size="$2"
    local media

    media=$(__dw_detect_media "$disk" "$size")

    local fs_type label
    label="NO NAME"

    case "$media" in
      floppy)
        fs_type="FAT12"
        label="FLOPPY"
        ;;
      zip)
        fs_type="FAT16"
        label="ZIP"
        ;;
      small)
        fs_type="FAT16"
        ;;
      medium)
        fs_type="FAT32"
        ;;
      large)
        fs_type="ExFAT"
        ;;
    esac

    if [ "$__DW_FAMILY" = "zip" ]; then
      label="ZIP"
    fi

    __log_info "Detected media: $media"
    __log_info "Creating filesystem ($fs_type)..."

    if [ "$media" = "floppy" ]; then
      case "$(uname)" in
        Darwin)
          if sudo newfs_msdos -F 12 -v "$label" "$disk" >/dev/null 2>&1; then
            __log_success "Formatted as $fs_type (superfloppy)"
          else
            __log_error "Failed to format floppy"
            return 1
          fi
          ;;
        Linux)
          if ! __cmd_exists mkfs.fat; then
            __log_error "mkfs.fat is not installed. Install the dosfstools package."
            return 1
          fi
          if sudo mkfs.fat -F 12 -n "$label" "$disk" >/dev/null 2>&1; then
            __log_success "Formatted as $fs_type (superfloppy)"
          else
            __log_error "Failed to format floppy"
            return 1
          fi
          ;;
      esac
      return 0
    fi

    case "$(uname)" in
      Darwin)
        local darwin_fs
        if [ "$fs_type" = "ExFAT" ]; then
          darwin_fs="ExFAT"
        else
          darwin_fs="MS-DOS $fs_type"
        fi
        if sudo diskutil eraseDisk "$darwin_fs" "$label" MBRFormat "$disk" >/dev/null 2>&1; then
          __log_success "Partition created ($fs_type)"
        else
          __log_error "Failed to create partition"
          return 1
        fi
        ;;
      Linux)
        if ! __cmd_exists sfdisk; then
          __log_error "sfdisk is not installed. Install the fdisk package."
          return 1
        fi

        local part_type mkfs_tool
        case "$media" in
          zip | small)
            part_type="06"
            mkfs_tool="mkfs.fat"
            ;;
          medium)
            part_type="0b"
            mkfs_tool="mkfs.fat"
            ;;
          large)
            part_type="07"
            mkfs_tool="mkfs.exfat"
            ;;
        esac

        if ! __cmd_exists "$mkfs_tool"; then
          __log_error "$mkfs_tool is not installed."
          return 1
        fi

        if ! echo ",,$part_type;" | sudo sfdisk "$disk" >/dev/null 2>&1; then
          __log_error "Failed to create partition table"
          return 1
        fi

        sudo partprobe "$disk" 2>/dev/null
        __cmd_exists udevadm && sudo udevadm settle >/dev/null 2>&1

        local partition
        if [[ "$disk" =~ [0-9]$ ]]; then
          partition="${disk}p1"
        else
          partition="${disk}1"
        fi

        local waited=0
        while [ ! -b "$partition" ] && [ "$waited" -lt 10 ]; do
          sleep 1
          waited=$((waited + 1))
        done

        if [ ! -b "$partition" ]; then
          __log_error "Partition $partition did not appear"
          return 1
        fi

        local format_ok=false
        case "$media" in
          zip|small)
            sudo mkfs.fat -F 16 -n "$label" "$partition" >/dev/null 2>&1 && format_ok=true
            ;;
          medium)
            sudo mkfs.fat -F 32 -n "$label" "$partition" >/dev/null 2>&1 && format_ok=true
            ;;
          large)
            sudo mkfs.exfat -n "$label" "$partition" >/dev/null 2>&1 && format_ok=true
            ;;
        esac

        if [ "$format_ok" = true ]; then
          __log_success "Partition created ($fs_type)"
        else
          __log_error "Failed to format partition"
          return 1
        fi
        ;;
    esac

    return 0
  }

  local input="$1"
  local passes="${PASSES:-1}"

  if [ -z "$input" ]; then
    __log_error "No device specified"
    __log_info "Usage: disk_wipe <device|mount_point>"
    __log_info "       disk_wipe /dev/disk4       (macOS, whole disk)"
    __log_info "       disk_wipe /dev/sdb         (Linux, whole disk)"
    __log_info "       disk_wipe /Volumes/USB     (macOS, mount point)"
    __log_info "       disk_wipe /mnt/usb         (Linux, mount point)"
    __log_info "       PASSES=N disk_wipe <device|mount_point>"
    __log_info "       CREATE=y disk_wipe <device|mount_point>"
    return 1
  fi

  local disk
  if [ -b "$input" ] || [ -c "$input" ]; then
    disk="$input"
  elif [ -d "$input" ]; then
    case "$(uname)" in
      Darwin) disk=$(diskutil info "$input" 2>/dev/null | awk -F': +' '/Device Node/ {print $2}') ;;
      Linux)  disk=$(command findmnt -n -o SOURCE "$input" 2>/dev/null) ;;
    esac
    if [ -z "$disk" ]; then
      __log_error "No device found for mount point: $input"
      return 1
    fi
  else
    __log_error "Not a device or mount point: $input"
    return 1
  fi

  # Walk up to the whole device (e.g., /dev/disk4s1 -> /dev/disk4)
  case "$(uname)" in
    Darwin)
      local whole
      whole=$(diskutil info "$disk" 2>/dev/null | awk -F': +' '/Part of Whole/ {print $2}')
      [ -n "$whole" ] && disk="/dev/$whole"
      ;;
    Linux)
      local stripped
      stripped=$(lsblk -no PKNAME "$disk" 2>/dev/null | head -1)
      [ -n "$stripped" ] && disk="/dev/$stripped"
      ;;
  esac
  __log_info "Device: $disk"

  __DW_ERRFILE=""
  __DW_LAST_ERROR=""
  __DW_LAST_DETAIL=""

  __dw_validate_params "$disk" "$passes" || return 1

  local identity
  identity=$(__dw_device_identity "$disk")
  __DW_FAMILY=$(__dw_device_family "$identity")
  if [ -n "$identity" ]; then
    __log_info "Device reports itself as: $identity"
  fi
  if [ -n "$__DW_FAMILY" ]; then
    __log_info "Recognised as $__DW_FAMILY media, which only sets the volume label."
  fi

  __DW_PROBES=7
  __DW_REPEATS=3
  __DW_RETRIES=3
  __DW_FACTOR_MIN=300
  __DW_FACTOR_MAX=1200
  __DW_SLACK=2
  __DW_CHUNK_TARGET=3000
  __DW_DEADLINE_CAP="${DEADLINE_CAP_MS:-120000}"
  __DW_PROBE_CEILING="${PROBE_CEILING_MS:-15000}"
  if __dw_fragile; then
    __DW_PROBES=2
    __DW_REPEATS=1
    __DW_RETRIES=1
    __DW_FACTOR_MIN=250
    __DW_FACTOR_MAX=400
    __log_info "Handling this as fragile media: fewer seeks while measuring, and no retry on a failed chunk."
  fi
  if __dw_head_crash_family; then
    __DW_FACTOR_MIN=175
    __DW_FACTOR_MAX=250
    __DW_SLACK=1
    __DW_CHUNK_TARGET=1000
    __DW_PROBE_CEILING="${PROBE_CEILING_MS:-4000}"
    __DW_DEADLINE_CAP="${DEADLINE_CAP_MS:-$__DW_PROBE_CEILING}"
    __log_info "A $__DW_FAMILY head that mistracks destroys the cartridge and then the next drive it meets."
    __log_info "Every transfer is therefore cut off at its own deadline rather than waited on, and one stall ends the run."
  fi
  if __dw_fragile; then
    __log_info "Any transfer past $(__dw_duration "$__DW_PROBE_CEILING") stops the run, because that is a head retrying rather than reading."
  fi

  __dw_confirm "$disk" || return 1

  local size
  case "$(uname)" in
    Darwin) size=$(diskutil info "$disk" 2>/dev/null | sed -nE 's/.*Disk Size:.*\(([0-9]+) Bytes\).*/\1/p') ;;
    Linux) size=$(sudo blockdev --getsize64 "$disk" 2>/dev/null) ;;
  esac
  if ! [[ "$size" =~ ^[0-9]+$ ]] || [ "$size" -eq 0 ]; then
    __log_error "Unable to determine disk size for $disk"
    return 1
  fi

  __DW_SECTOR=$(__dw_sector_bytes "$disk")

  if [ $((size % __DW_SECTOR)) -ne 0 ]; then
    __log_warning "Device size is not a whole number of sectors. Skipping the last $((size % __DW_SECTOR)) bytes."
    size=$((size - size % __DW_SECTOR))
  fi

  __DW_CEILING=$((1024 * 1024))
  while [ "$__DW_CEILING" -gt "$__DW_SECTOR" ] && [ $((__DW_CEILING * 16)) -gt "$size" ]; do
    __DW_CEILING=$((__DW_CEILING / 2))
  done

  local writable=0
  __dw_writable_media "$disk" || writable=$?
  if [ "$writable" -eq 1 ]; then
    __dw_report_write_protected "$disk" flag
    return 1
  fi

  if ! sudo -n true 2>/dev/null; then
    __log_info "Administrator access is required to reach the raw device."
    if ! sudo -v; then
      __log_error "Administrator access was not granted"
      return 1
    fi
  fi

  __log_info "Unmounting $disk..."
  case "$(uname)" in
    Darwin)
      if __dw_release_darwin "$disk"; then
        __log_success "Disk unmounted"
      else
        __log_error "Disk is still mounted, so wiping it would corrupt the mounted volume"
        return 1
      fi
      ;;
    Linux)
      local released=0
      local child
      for child in $(lsblk -nro NAME "$disk" 2>/dev/null); do
        if sudo umount "/dev/$child" 2>/dev/null; then
          released=$((released + 1))
        fi
      done
      if sudo umount "$disk" 2>/dev/null; then
        released=$((released + 1))
      fi
      if [ "$released" -gt 0 ]; then
        __log_success "Disk unmounted"
      else
        __log_warning "Failed to unmount disk (may not be mounted)"
      fi
      ;;
  esac

  __dw_probe_cache_bypass "$(__dw_io_device "$disk")" "$__DW_SECTOR"

  zmodload zsh/datetime 2>/dev/null || true

  __DW_TMPDIR=$(mktemp -d "${TMPDIR:-/tmp}/disk_wipe.XXXXXX") || {
    __log_error "Unable to create a working directory"
    return 1
  }
  __DW_ERRFILE="${__DW_TMPDIR}/last-error"
  : >"$__DW_ERRFILE"
  __DW_DRIFT_WRITE=100
  __DW_DRIFT_READ=100
  __DW_MEASURED=0
  __DW_RATE_READ=0
  __DW_RATE_WRITE=0
  __DW_OVERHEAD_READ=0
  __DW_OVERHEAD_WRITE=0
  __DW_FACTOR_READ=0
  __DW_FACTOR_WRITE=0
  __DW_TIMED_OUT=0
  __DW_INTERRUPTED=0
  __DW_DEADLINE=$(__dw_idle_deadline)

  local landed=0
  __dw_writes_land "$disk" || landed=$?
  if [ "$landed" -eq 1 ]; then
    __dw_report_write_protected "$disk" silent
    rm -rf "$__DW_TMPDIR"
    __DW_ERRFILE=""
    return 1
  fi
  if [ "$landed" -eq 2 ] && [ "$(__dw_error_class "$(__dw_get_error)")" = "bus" ]; then
    __dw_fault "$disk" "$disk stopped answering during the single-sector write test"
    rm -rf "$__DW_TMPDIR"
    __DW_ERRFILE=""
    return 1
  fi

  __log_info "Measuring $disk before wiping it, so every limit comes from this disk."
  local calibration=0
  local write_calibration=0
  __dw_calibrate read "$disk" "$size" || calibration=$?
  if [ "$calibration" -ne 2 ] && __dw_device_gone "$disk"; then
    calibration=2
    __log_error "$disk left the bus while it was being measured."
  fi
  if [ "$calibration" -ne 2 ]; then
    __dw_calibrate write "$disk" "$size" || write_calibration=$?
    [ "$write_calibration" -gt "$calibration" ] && calibration="$write_calibration"
  fi

  case "$calibration" in
    0) __DW_MEASURED=1 ;;
    2)
      __dw_fault "$disk" "the disk failed while being measured, before the wipe started"
      rm -rf "$__DW_TMPDIR"
      __DW_ERRFILE=""
      return 1
      ;;
    *)
      if __dw_fragile; then
        __log_error "STOPPED: this disk could not be timed, so nothing would be watching for a stall."
        __log_error "On $__DW_FAMILY media the clock is what catches a failing head before it scores the surface."
        __log_error "Running blind would risk the cartridge and the drive, so this stops here."
        __dw_eject_now "$disk"
        rm -rf "$__DW_TMPDIR"
        __DW_ERRFILE=""
        return 1
      fi
      __log_warning "Speed is not being watched on this disk. Only the byte-for-byte verify decides."
      ;;
  esac

  if [ "$__DW_MEASURED" = "1" ]; then
    __DW_CHUNK=$(__dw_chunk_bytes "$size")
  else
    __DW_CHUNK="$__DW_CEILING"
    [ "$__DW_CHUNK" -gt "$size" ] && __DW_CHUNK="$size"
  fi

  __log_info "Cleaning $disk..."
  local wipe_status=0
  for ((index=1; index <= passes; index++)); do
    if ! __dw_execute_pass "$disk" "$size" "$index" "$passes"; then
      wipe_status=1
      break
    fi
  done

  rm -rf "$__DW_TMPDIR"
  __DW_ERRFILE=""
  [ "$wipe_status" -ne 0 ] && return 1

  if [ "${CREATE:-}" = "y" ] && ! __dw_create_partition "$disk" "$size"; then
    return 1
  fi

  __log_info "Ejecting device..."
  case "$(uname)" in
    Darwin)
      case "$__DW_FAMILY" in
        floppy | superdisk)
          if __dw_release_darwin "$disk"; then
            __log_success "Device unmounted. This drive has no software eject, so remove the disk by hand."
          else
            __log_warning "Device is still mounted. Remove the disk by hand once it is idle."
          fi
          ;;
        *)
          if __dw_bounded 30 sudo diskutil eject "$disk" >/dev/null 2>&1; then
            __log_success "Device ejected successfully"
          else
            __log_warning "Failed to eject device. The wipe already finished, so it is safe to remove."
          fi
          ;;
      esac
      ;;
    Linux)
      sync
      if sudo eject "$disk" 2>/dev/null; then
        __log_success "Device ejected successfully"
      else
        __log_warning "Failed to eject device (may not support eject)"
      fi
      ;;
  esac
}

################################################################################
# Clean and sort a FAT device
################################################################################
function fat_sort() {
  if ! __cmd_exists fatsort; then
    __log_error "fatsort is not installed."
    return 1
  fi

  __fat_sort_mount_point() {
    local partition="$1"

    case "$(uname)" in
      Darwin)
        diskutil info "$partition" 2>/dev/null | awk -F': +' '/Mount Point/ {print $2}'
        ;;
      Linux)
        command findmnt -n -o TARGET "$partition" 2>/dev/null
        ;;
    esac
  }

  __fat_sort_find_partition() {
    local device="$1"

    case "$(uname)" in
      Darwin)
        if [[ "$device" =~ s[0-9]+$ ]]; then
          echo "$device"
          return 0
        fi

        local partition
        partition=$(diskutil list "$device" 2>/dev/null | grep -iE "DOS_FAT|Windows_FAT|Microsoft Basic Data" | awk '{print $NF}' | head -1)

        if [ -n "$partition" ]; then
          echo "/dev/$partition"
          return 0
        fi

        __log_error "No FAT partition found on $device"
        return 1
        ;;
      Linux)
        if [[ "$device" =~ [0-9]$ ]]; then
          echo "$device"
          return 0
        fi

        echo "${device}1"
        return 0
        ;;
    esac
  }

  __fat_sort_ensure_mounted() {
    local partition="$1"
    local mount_point

    mount_point=$(__fat_sort_mount_point "$partition")
    if [ -n "$mount_point" ]; then
      echo "$mount_point"
      return 0
    fi

    __log_info "Mounting $partition..."

    case "$(uname)" in
      Darwin)
        if diskutil mount "$partition" >/dev/null 2>&1; then
          mount_point=$(__fat_sort_mount_point "$partition")
          if [ -n "$mount_point" ]; then
            echo "$mount_point"
            return 0
          fi
        fi
        ;;
      Linux)
        mount_point="/tmp/fatsort_$$"
        mkdir -p "$mount_point"
        if sudo mount "$partition" "$mount_point" 2>/dev/null; then
          echo "$mount_point"
          return 0
        fi
        rmdir "$mount_point" 2>/dev/null
        ;;
    esac

    return 1
  }

  __fat_sort_unmount() {
    local partition="$1"

    case "$(uname)" in
      Darwin)
        diskutil unmount force "$partition" >/dev/null 2>&1
        local attempts=0
        while [ -n "$(__fat_sort_mount_point "$partition")" ] && [ "$attempts" -lt 10 ]; do
          sleep 1
          attempts=$((attempts + 1))
        done
        if [ -n "$(__fat_sort_mount_point "$partition")" ]; then
          __log_error "Failed to unmount $partition after ${attempts}s"
          return 1
        fi
        ;;
      Linux)
        sudo umount "$partition" 2>/dev/null
        local mount_point="/tmp/fatsort_$$"
        [ -d "$mount_point" ] && rmdir "$mount_point" 2>/dev/null
        ;;
    esac
  }

  __fat_sort_clean() {
    local mount_point="$1"
    local total=0

    __log_info "Cleaning temporary files..."

    if [ "$(uname)" = "Darwin" ]; then
      sudo mdutil -X "$mount_point" >/dev/null 2>&1
    fi

    local patterns=()
    local macos_pattern
    while IFS= read -r macos_pattern; do
      patterns+=("$macos_pattern")
    done < <(__macos_metadata_patterns)

    # shellcheck disable=SC2016
    patterns+=(
      # macOS fsck recovery
      "FSCK*.REC"
      # macOS HFS+ wrapper artifacts
      ".hotfiles.btree"
      ".journal"
      ".journal_info_block"
      # Mac OS 9 / Classic
      "Icon?"
      "Network Trash Folder"
      "Temporary Items"
      "TheFindByContentFolder"
      "TheVolumeSettingsFolder"
      # Windows (Vista+)
      '$RECYCLE.BIN'
      "Desktop.ini"
      "Thumbs.db"
      "ehthumbs.db"
      "ehthumbs_vista.db"
      # Windows (2000/XP)
      "RECYCLER"
      # Windows (95/98/ME)
      "RECYCLED"
      # Windows shared
      "System Volume Information"
      "autorun.inf"
      # Windows Search / sync markers
      "IndexerVolumeGuid"
      "WPSettings.dat"
      # Windows dump logs
      "DumpStack.log"
      "DumpStack.log.tmp"
      # CHKDSK recovered fragments
      "FOUND.*"
      # Office lock/temp files
      '~$*'
      ".~lock.*"
      # Synology NAS
      "@eaDir"
      "#recycle"
      # QNAP NAS
      "@Recycle"
      ".@__thumb"
      # Dropbox
      ".dropbox"
      ".dropbox.attr"
      # Linux
      ".directory"
      ".Trash-*"
    )

    local count
    for pattern in "${patterns[@]}"; do
      count=$(command find "$mount_point" -iname "$pattern" 2>/dev/null | command wc -l | tr -d ' ')

      if [ "$count" -gt 0 ]; then
        command find "$mount_point" -iname "$pattern" -exec rm -rf {} + 2>/dev/null
        total=$((total + count))
        __log_info "  Removed: $pattern ($count)"
      fi
    done

    if [ "$total" -gt 0 ]; then
      __log_success "Cleaned $total items"
    else
      __log_info "No junk files found"
    fi
  }

  local input="$1"

  if [ -z "$input" ]; then
    __log_error "No device specified"
    echo ""
    __log_info "Usage: fat_sort <device|mount_point>"
    __log_info "       fat_sort /dev/disk4       (macOS, whole disk)"
    __log_info "       fat_sort /dev/disk4s1     (macOS, partition)"
    __log_info "       fat_sort /dev/sdb1        (Linux, partition)"
    __log_info "       fat_sort /Volumes/EZFLASH (macOS, mount point)"
    __log_info "       fat_sort /mnt/usb         (Linux, mount point)"
    return 1
  fi

  local device
  if [ -b "$input" ] || [ -c "$input" ]; then
    device="$input"
  elif [ -d "$input" ]; then
    case "$(uname)" in
      Darwin) device=$(diskutil info "$input" 2>/dev/null | awk -F': +' '/Device Node/ {print $2}') ;;
      Linux)  device=$(command findmnt -n -o SOURCE "$input" 2>/dev/null) ;;
    esac
    if [ -z "$device" ]; then
      __log_error "No device found for mount point: $input"
      return 1
    fi
  else
    __log_error "Not a device or mount point: $input"
    return 1
  fi

  local partition
  partition=$(__fat_sort_find_partition "$device") || return 1
  __log_info "Partition: $partition"

  local mount_point
  mount_point=$(__fat_sort_ensure_mounted "$partition")
  if [ -z "$mount_point" ]; then
    __log_error "Failed to mount $partition"
    return 1
  fi

  __log_info "Mounted at: $mount_point"
  __fat_sort_clean "$mount_point"

  sync
  __log_info "Unmounting..."
  if ! __fat_sort_unmount "$partition"; then
    return 1
  fi

  __log_info "Sorting..."
  if sudo fatsort -c -o d "$partition" >/dev/null; then
    __log_success "Device sorted: $partition"
  else
    __log_error "Failed to sort: $partition"
    return 1
  fi
}

################################################################################
# Stop macOS writing its metadata onto an external volume
################################################################################
function disk_quiet() {
  __dq_usage() {
    __log_info "Usage: disk_quiet <device|mount_point>"
    __log_info "       disk_quiet /Volumes/ZIP100    (mount point)"
    __log_info "       disk_quiet /dev/disk8s1       (partition)"
    __log_info "       disk_quiet /dev/disk8         (whole disk)"
    __log_info "       NO_LOG=y disk_quiet <...>     (also write .fseventsd/no_log)"
    __log_info "       EJECT=y  disk_quiet <...>     (eject when finished)"
  }

  __dq_mount_point() {
    diskutil info "$1" 2>/dev/null | awk -F': +' '/Mount Point/ {print $2}'
  }

  __dq_resolve() {
    local input="$1"
    local mount_point

    if [ -d "$input" ] && [ ! -b "$input" ] && [ ! -c "$input" ]; then
      echo "$input"
      return 0
    fi

    mount_point=$(__dq_mount_point "$input")
    if [ -n "$mount_point" ]; then
      echo "$mount_point"
      return 0
    fi

    local partition
    partition=$(diskutil list "$input" 2>/dev/null |
      grep -iE "DOS_FAT|Windows_FAT|Microsoft Basic Data|ExFAT|Apple_HFS|Apple_APFS" |
      awk '{print $NF}' | head -1)
    [ -z "$partition" ] && return 1

    mount_point=$(__dq_mount_point "/dev/$partition")
    if [ -z "$mount_point" ]; then
      diskutil mount "/dev/$partition" >/dev/null 2>&1 || return 1
      mount_point=$(__dq_mount_point "/dev/$partition")
    fi

    [ -z "$mount_point" ] && return 1
    echo "$mount_point"
  }

  __dq_is_removable_volume() {
    local mount_point="$1"
    local info

    if [ -z "$mount_point" ] || [ ! -d "$mount_point" ]; then
      __log_error "Not a mounted volume: ${mount_point:-<empty>}"
      return 1
    fi

    info=$(diskutil info "$mount_point" 2>/dev/null)
    if [ -z "$info" ]; then
      __log_error "Refusing: $mount_point is not a volume"
      return 1
    fi

    if echo "$info" | grep -qE "Removable Media: +Removable" ||
      echo "$info" | grep -qE "Device Location: +External"; then
      return 0
    fi

    __log_error "Refusing: $mount_point is not a removable or external volume"
    return 1
  }

  __dq_remove_metadata() {
    local mount_point="$1"
    local patterns=()
    local pattern count total=0

    while IFS= read -r pattern; do
      patterns+=("$pattern")
    done < <(__macos_metadata_patterns)

    for pattern in "${patterns[@]}"; do
      count=$(command find "$mount_point" -iname "$pattern" 2>/dev/null | command wc -l | tr -d ' ')

      if [ "$count" -gt 0 ]; then
        command find "$mount_point" -iname "$pattern" -exec rm -rf {} + 2>/dev/null
        total=$((total + count))
        __log_info "  Removed: $pattern ($count)"
      fi
    done

    if [ "$total" -gt 0 ]; then
      __log_success "Removed $total item(s)"
    else
      __log_info "Nothing to remove"
    fi
  }

  local input="$1"

  if [ "$(uname)" != "Darwin" ]; then
    __log_error "disk_quiet applies to macOS only"
    return 1
  fi

  if [ -z "$input" ]; then
    __log_error "No device specified"
    __dq_usage
    return 1
  fi

  local mount_point
  mount_point=$(__dq_resolve "$input")
  if [ -z "$mount_point" ]; then
    __log_error "No mounted volume found for: $input"
    return 1
  fi

  __dq_is_removable_volume "$mount_point" || return 1
  __log_info "Volume: $mount_point"

  if __macos_no_ds_store_on_foreign_volumes; then
    __log_success "Finder will not write .DS_Store to USB or network volumes"
  else
    __log_warning "Could not set the Finder defaults"
  fi

  __log_info "Disabling Spotlight for this volume..."
  if sudo mdutil -i off -d "$mount_point" >/dev/null 2>&1; then
    __log_success "Spotlight disabled"
  else
    __log_warning "Could not disable Spotlight (volume may be read-only)"
  fi

  sudo mdutil -X "$mount_point" >/dev/null 2>&1

  __log_info "Removing macOS metadata..."
  __dq_remove_metadata "$mount_point"

  if [ "${NO_LOG}" = "y" ]; then
    __log_info "Writing .fseventsd/no_log..."
    if mkdir -p "$mount_point/.fseventsd" 2>/dev/null &&
      : >"$mount_point/.fseventsd/no_log" 2>/dev/null; then
      __log_success "FSEvents will not log on this volume"
    else
      __log_warning "Could not write .fseventsd/no_log"
    fi
  fi

  sync

  if [ "${EJECT}" = "y" ]; then
    __log_info "Ejecting..."
    if sudo diskutil eject "$mount_point" >/dev/null 2>&1; then
      __log_success "Ejected, safe to remove"
    else
      __log_error "Failed to eject"
      return 1
    fi
  fi
}
