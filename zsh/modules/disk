#!/usr/bin/env bash

__DISK_LINUX_MOUNT="/tmp/fat_sort_$$"
__DISK_WAIT_DELAYS="0.05 0.1 0.2 0.4 0.8 1.6 3.2 3.2"

function __fat_sort_help() {
  cat <<'HELP'
fat_sort - remove junk files from a FAT volume, then sort its directories

usage:
  fat_sort <device|volume>    clean and sort the FAT partition behind it
  fat_sort help               print this page

notes:
  A whole disk, a partition or a mounted volume are all accepted; a whole
  disk uses its first FAT or exFAT partition. Before anything is removed,
  it asks you to type the partition name.
  It removes macOS, Windows, NAS and Linux metadata, unmounts the
  partition, then runs fatsort, which needs root.

examples:
  fat_sort /dev/disk4
  fat_sort /Volumes/EZFLASH
  fat_sort /dev/sdb1
HELP
}

function __disk_quiet_help() {
  cat <<'HELP'
disk_quiet - stop macOS writing its metadata onto an external volume

usage:
  disk_quiet [options] <device|volume>    quiet one removable volume
  disk_quiet help                         print this page

options:
  --no-log     also write .fseventsd/no_log on the volume
  --eject      eject the volume when finished

notes:
  macOS only, and only for removable or external volumes. It tells Finder
  to stop writing .DS_Store to USB and network volumes, turns Spotlight
  off for the volume, and removes the metadata already there.

examples:
  disk_quiet /Volumes/ZIP100
  disk_quiet --eject /dev/disk8
HELP
}

function __disk_junk_patterns() {
  __macos_metadata_patterns
  # shellcheck disable=SC2016
  printf '%s\n' "FSCK*.REC" ".hotfiles.btree" ".journal" ".journal_info_block" \
    $'Icon\r' "Network Trash Folder" "Temporary Items" "TheFindByContentFolder" \
    "TheVolumeSettingsFolder" '$RECYCLE.BIN' "Desktop.ini" "Thumbs.db" "ehthumbs.db" \
    "ehthumbs_vista.db" "RECYCLER" "RECYCLED" "System Volume Information" "autorun.inf" \
    "IndexerVolumeGuid" "WPSettings.dat" "DumpStack.log" "DumpStack.log.tmp" \
    'FOUND.[0-9][0-9][0-9]' '~$*' ".~lock.*" "@eaDir" "#recycle" "@Recycle" \
    ".@__thumb" ".dropbox" ".dropbox.attr" ".directory" ".Trash-*"
}

function __disk_remove_matching() {
  local mount_point="$1"
  local pattern

  while IFS= read -r pattern; do
    command find "$mount_point" -iname "$pattern" -exec rm -rf {} +
  done
}

function __disk_mount_point() {
  case "$(uname)" in
    Darwin) diskutil info "$1" 2>/dev/null | awk -F': +' '/Mount Point/ {print $2}' ;;
    Linux) command findmnt -n -o TARGET "$1" ;;
  esac
}

function __disk_device_for() {
  local name="$1"
  local input="$2"
  local device=""

  if [ -b "$input" ] || [ -c "$input" ]; then
    printf '%s\n' "$input"
    return 0
  fi
  if [ -d "$input" ]; then
    case "$(uname)" in
      Darwin) device="$(diskutil info "$input" 2>/dev/null | awk -F': +' '/Device Node/ {print $2}')" ;;
      Linux) device="$(command findmnt -n -o SOURCE "$input")" ;;
    esac
  fi
  if [ -z "$device" ]; then
    __error "$name" "${input} is not a device or a mounted volume."
    return 1
  fi
  printf '%s\n' "$device"
}

function __disk_fat_partition() {
  local device="$1"

  case "$(uname)" in
    Darwin)
      if [[ "$device" =~ s[0-9]+$ ]]; then
        printf '%s\n' "$device"
        return 0
      fi
      diskutil list "$device" | grep -iE "DOS_FAT|Windows_FAT|Microsoft Basic Data" | awk 'NR == 1 {print "/dev/" $NF}'
      ;;
    Linux)
      if [ "$(lsblk -dnro TYPE "$device")" = "part" ]; then
        printf '%s\n' "$device"
        return 0
      fi
      lsblk -nro NAME,FSTYPE "$device" | awk '$2 ~ /^(vfat|exfat|msdos)$/ { print "/dev/" $1; exit }'
      ;;
  esac
}

function __disk_require_fat() {
  local partition="$1"
  local fs_type=""

  case "$(uname)" in
    Darwin) fs_type="$(diskutil info "$partition" | awk -F': +' '/Type \(Bundle\)/ {print $2}')" ;;
    Linux) fs_type="$(lsblk -dnro FSTYPE "$partition")" ;;
  esac
  case "$fs_type" in
    msdos | vfat | exfat) return 0 ;;
    *)
      __stop fat_sort "${partition} is ${fs_type:-of an unknown type}, not FAT or exFAT"
      return 1
      ;;
  esac
}

function __disk_ensure_mounted() {
  local partition="$1"
  local mount_point

  mount_point="$(__disk_mount_point "$partition")"
  if [ -z "$mount_point" ]; then
    case "$(uname)" in
      Darwin) diskutil mount "$partition" >&2 && mount_point="$(__disk_mount_point "$partition")" ;;
      Linux) mkdir -p "$__DISK_LINUX_MOUNT" && sudo mount "$partition" "$__DISK_LINUX_MOUNT" && mount_point="$__DISK_LINUX_MOUNT" ;;
    esac
  fi
  [ -n "$mount_point" ] || return 1
  printf '%s\n' "$mount_point"
}

function __disk_unmount() {
  local partition="$1"
  local delay

  case "$(uname)" in
    Linux)
      sudo umount "$partition" || return 1
      [ -d "$__DISK_LINUX_MOUNT" ] && rmdir "$__DISK_LINUX_MOUNT"
      return 0
      ;;
  esac
  diskutil unmount force "$partition"
  for delay in ${=__DISK_WAIT_DELAYS}; do
    [ -z "$(__disk_mount_point "$partition")" ] && return 0
    sleep "$delay"
  done
  [ -z "$(__disk_mount_point "$partition")" ]
}

function __disk_confirm() {
  local name="$1"
  local partition="$2"
  local action="$3"
  local short="${partition##*/}"
  local answer

  if [ ! -t 0 ]; then
    __stop "$name" "no terminal to confirm on"
    return 1
  fi
  printf 'Type %s to %s, or anything else to stop: ' "$short" "$action" >&2
  read -r answer
  [ "$answer" = "$short" ] && return 0
  __stop "$name" "nothing was changed"
  return 1
}

function __fat_sort_target() {
  local input="$1"
  local device partition

  device="$(__disk_device_for fat_sort "$input")" || return 1
  partition="$(__disk_fat_partition "$device")"
  if [ -z "$partition" ]; then
    __error fat_sort "no FAT partition found on ${device}."
    return 1
  fi
  __disk_require_fat "$partition" || return 1
  printf '%s\n' "$partition"
}

function fat_sort() {
  case "${1:-}" in
    help | -h | --help) __fat_sort_help; return 0 ;;
    "") __usage_error fat_sort "no device given"; return 1 ;;
    -*) __usage_error fat_sort "unknown option '$1'"; return 1 ;;
  esac
  if ! __cmd_exists fatsort; then
    __error fat_sort "fatsort is not installed."
    return 1
  fi

  local partition mount_point
  partition="$(__fat_sort_target "$1")" || return 1
  mount_point="$(__disk_ensure_mounted "$partition")" || {
    __error fat_sort "could not mount ${partition}."
    return 1
  }
  __disk_confirm fat_sort "$partition" "remove the junk files in ${mount_point}, then sort it" || return 1

  __disk_junk_patterns | __disk_remove_matching "$mount_point"
  sync
  __disk_unmount "$partition" || {
    __error fat_sort "could not unmount ${partition}."
    return 1
  }
  sudo fatsort -c -o d "$partition" || {
    __error fat_sort "fatsort failed on ${partition}."
    return 1
  }
}

function __disk_quiet_volume() {
  local input="$1"
  local mount_point partition

  if [ -d "$input" ] && [ ! -b "$input" ] && [ ! -c "$input" ]; then
    printf '%s\n' "$input"
    return 0
  fi
  mount_point="$(__disk_mount_point "$input")"
  if [ -z "$mount_point" ]; then
    partition="$(diskutil list "$input" |
      grep -iE "DOS_FAT|Windows_FAT|Microsoft Basic Data|ExFAT|Apple_HFS|Apple_APFS" |
      awk 'NR == 1 {print "/dev/" $NF}')"
    [ -n "$partition" ] || return 1
    mount_point="$(__disk_mount_point "$partition")"
    [ -n "$mount_point" ] || { diskutil mount "$partition" >&2 && mount_point="$(__disk_mount_point "$partition")"; }
  fi
  [ -n "$mount_point" ] || return 1
  printf '%s\n' "$mount_point"
}

function __disk_quiet_require_removable() {
  local mount_point="$1"
  local info

  info="$(diskutil info "$mount_point" 2>/dev/null)"
  if [ -z "$info" ]; then
    __stop disk_quiet "${mount_point} is not a volume"
    return 1
  fi
  if printf '%s\n' "$info" | grep -qE "Removable Media: +Removable|Device Location: +External"; then
    return 0
  fi
  __stop disk_quiet "${mount_point} is not a removable or external volume"
  return 1
}

function __disk_quiet_apply() {
  local mount_point="$1"
  local no_log="$2"

  __macos_no_ds_store_on_foreign_volumes || __warn disk_quiet "could not set the Finder defaults."
  sudo mdutil -i off -d "$mount_point" || __warn disk_quiet "could not turn Spotlight off; the volume may be read-only."
  sudo mdutil -X "$mount_point"
  __macos_metadata_patterns | __disk_remove_matching "$mount_point"
  if [ "$no_log" = 1 ] && ! { mkdir -p "$mount_point/.fseventsd" && : >"$mount_point/.fseventsd/no_log"; }; then
    __warn disk_quiet "could not write .fseventsd/no_log."
  fi
  sync
}

function disk_quiet() {
  local no_log=0 eject=0 input="" mount_point

  while [ $# -gt 0 ]; do
    case "$1" in
      help | -h | --help) __disk_quiet_help; return 0 ;;
      --no-log) no_log=1 ;;
      --eject) eject=1 ;;
      --) shift; input="${1:-}"; break ;;
      -*) __usage_error disk_quiet "unknown option '$1'"; return 1 ;;
      *) input="$1" ;;
    esac
    shift
  done
  if [ "$(uname)" != "Darwin" ]; then
    __error disk_quiet "this command is for macOS only."
    return 1
  fi
  [ -n "$input" ] || { __usage_error disk_quiet "no device given"; return 1; }
  mount_point="$(__disk_quiet_volume "$input")" || {
    __error disk_quiet "no mounted volume found for ${input}."
    return 1
  }
  __disk_quiet_require_removable "$mount_point" || return 1
  __disk_quiet_apply "$mount_point" "$no_log"
  [ "$eject" = 1 ] || return 0
  sudo diskutil eject "$mount_point" || { __error disk_quiet "could not eject ${mount_point}."; return 1; }
}
