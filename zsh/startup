#!/usr/bin/env bash

################################################################################
# Tmux Auto-Start
################################################################################
# Every terminal joins the one "main" session, the same one tmux starts at login
# Skip for the VSCode and Vim integrated terminals
if [ -z "$TMUX" ] && [ "$TERM_PROGRAM" != "vscode" ] && [ "$TERM_PROGRAM" != "vim" ] && command -v tmux >/dev/null 2>&1; then
  tmux new-session -A -s main
fi

################################################################################
# Tmux Terminal Settings
################################################################################
if [ -n "$TMUX" ]; then
  export TERM="tmux-256color"
fi
