#!/usr/bin/env bash

__DOTFILES_WIDTH=80

function __wrap() {
  local fd="$1"
  local text="$2"

  if [ -t "$fd" ] && [ "${#text}" -gt "$__DOTFILES_WIDTH" ]; then
    printf '%s\n' "$text" | command awk -v width="$__DOTFILES_WIDTH" '
      {
        line = ""
        count = split($0, words, " ")
        for (i = 1; i <= count; i++) {
          if (line == "") { line = words[i] }
          else if (length(line) + 1 + length(words[i]) <= width) { line = line " " words[i] }
          else { print line; line = words[i] }
        }
        print line
      }' >&"$fd"
  else
    printf '%s\n' "$text" >&"$fd"
  fi
}

function __say() {
  __wrap 1 "$*"
}

function __warn() {
  local name="$1"
  shift
  __wrap 2 "${name}: warning: $*"
}

function __error() {
  local name="$1"
  shift
  __wrap 2 "${name}: $*"
}

function __stop() {
  local name="$1"
  shift
  __wrap 2 "${name}: stopped: $*."
}

function __usage_error() {
  local name="$1"
  shift
  __wrap 2 "${name}: $*. run '${name} help' for usage."
}

function __cmd_exists() {
  command -v "$1" >/dev/null 2>&1
}

function __safe_link() {
  local src="$1"
  local dst="$2"
  local backup

  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    return 0
  fi

  if [ -L "$dst" ]; then
    rm -f "$dst"
  elif [ -e "$dst" ]; then
    backup="${dst}.backup.$(date +%Y%m%d%H%M%S)"
    mv "$dst" "$backup"
  fi

  mkdir -p "$(dirname "$dst")"
  ln -s "$src" "$dst"
}

function __add_to_path() {
  local p=":$PATH:"
  p="${p//:$1:/:}"
  p="${p#:}"
  p="${p%:}"
  export PATH="$1${p:+:$p}"
}

function __append_to_path() {
  local p=":$PATH:"
  p="${p//:$1:/:}"
  p="${p#:}"
  p="${p%:}"
  export PATH="${p:+$p:}$1"
}

function __add_formula_path() {
  local tool="$1"
  local subpath="${2:-bin}"
  __add_to_path "$HOMEBREW_PREFIX/opt/$tool/$subpath"
}

function __setup_homebrew() {
  local prefix="$1"

  export HOMEBREW_PREFIX="$prefix"
  export HOMEBREW_CELLAR="$prefix/Cellar"
  export HOMEBREW_REPOSITORY="$prefix"
  [ "$prefix" = "/usr/local" ] && export HOMEBREW_REPOSITORY="/usr/local/Homebrew"
  export HOMEBREW_SHELLENV_PREFIX="$prefix"
  __add_to_path "$prefix/bin"
  __add_to_path "$prefix/sbin"
  if [[ ":$MANPATH:" != *":$prefix/share/man:"* ]]; then
    export MANPATH="$prefix/share/man${MANPATH+:$MANPATH}:"
  fi
  if [[ ":$INFOPATH:" != *":$prefix/share/info:"* ]]; then
    export INFOPATH="$prefix/share/info:${INFOPATH:-}"
  fi
}

function __macos_no_ds_store_on_foreign_volumes() {
  [ "$(uname)" = "Darwin" ] || return 0

  local key changed=0
  for key in DSDontWriteUSBStores DSDontWriteNetworkStores; do
    if [ "$(defaults read com.apple.desktopservices "$key" 2>/dev/null)" != "1" ]; then
      defaults write com.apple.desktopservices "$key" -bool true || return 1
      changed=1
    fi
  done

  [ "$changed" -eq 1 ] && killall Finder
  return 0
}

function __macos_post_install_cleanup() {
  if [ "$(sw_vers -productVersion | cut -d. -f1)" -lt 26 ]; then
    sudo find /private/var/folders/ -type d -name com.apple.dock.launchpad -exec rm -rf {} + && killall Dock
  fi
  local dir
  for dir in /Applications "$HOME/Applications"; do
    [ -d "$dir" ] && mdimport "$dir"
  done
  return 0
}

function __alias_if_exists() {
  local cmd="$1"
  local alias_name="$2"
  local alias_value="$3"

  # shellcheck disable=SC2139
  command -v "$cmd" >/dev/null && alias "$alias_name"="$alias_value"
}
