#!/usr/bin/env bash

__F5_KEEPALIVE_INTERVAL=60
__F5_KEEPALIVE_ROUNDS=720
__F5_BREWFILE="$HOME/.dotfiles/Brewfile"
__F5_UVFILE="$HOME/.dotfiles/Uvfile"

function __f5_keepalive() {
  local parent="$1"
  local rounds=0

  while [ "$rounds" -lt "$__F5_KEEPALIVE_ROUNDS" ] && kill -0 "$parent" 2>/dev/null; do
    sleep "$__F5_KEEPALIVE_INTERVAL"
    sudo -n -v 2>/dev/null || return 0
    rounds=$((rounds + 1))
  done
}

function __f5_sudo_begin() {
  sudo -v || return 1
  __F5_KEEPALIVE_PID="$( (__f5_keepalive "$$" >/dev/null 2>&1 & echo $!))"
}

function __f5_sudo_end() {
  if [ -n "${__F5_KEEPALIVE_PID:-}" ]; then
    kill "$__F5_KEEPALIVE_PID" 2>/dev/null
    unset __F5_KEEPALIVE_PID
  fi
  sudo -k
}

function __f5_step() {
  "$@" || __f5_failed=1
  return 0
}

function __f5_step_if() {
  local tool="$1"
  shift
  __cmd_exists "$tool" || return 0
  __f5_step "$@"
}

function __f5_git_pull() {
  git -C "$1" pull --prune --verbose
}

function __f5_git_update() {
  local dir="$1"

  __f5_git_pull "$dir" || return
  [ -f "$dir/.gitmodules" ] || return 0
  git -C "$dir" submodule update --init --remote --recursive
}

function __f5_update_repos() {
  local dir

  for dir in "$HOME/.dotfiles" "$HOME/.aws" "$HOME/.claude"; do
    [ -d "$dir/.git" ] || continue
    __f5_step __f5_git_update "$dir"
  done
}

function __f5_update_plugins() {
  setopt local_options null_glob
  local dir

  for dir in "$HOME/.oh-my-zsh" "$HOME/.oh-my-zsh/custom"/{themes,plugins}/*/ "$HOME/.dotfiles/tmux/plugins"/*/; do
    dir="${dir%/}"
    [ -d "$dir/.git" ] || continue
    [ "$dir" = "$HOME/.dotfiles/tmux/plugins/tpm" ] && continue
    __f5_step __f5_git_pull "$dir"
  done
}

function __f5_update_editors() {
  __f5_step_if vim vim -es -N -u "$HOME/.vimrc" -i NONE \
    -c "PlugUpgrade" -c "PlugUpdate --sync" -c "CocUpdateSync" \
    -c 'try | PlugClean! | catch /^Vim\%((\a\+)\)\=:E16:/ | endtry' -c "qa!" </dev/null
  __f5_step_if nvim nvim --headless "+Lazy! sync" +qa
  __f5_step_if nvim nvim --headless +TSUpdateSync +qa
  __f5_step_if nvim nvim --headless +MasonUpdate +qa
}

function __f5_update_runtimes() {
  __f5_step_if tldr tldr --update
  __f5_step_if mise mise upgrade --yes
  __f5_step_if mise mise prune --yes
}

function __f5_strip_tap_quarantine() {
  local apps app apppath

  apps="$(brew info --cask --json=v2 --installed |
    jq -r '.casks[] | select(.tap == "gufranco/tap") | .artifacts[].app[]? // empty')" || return
  while IFS= read -r app; do
    [ -n "$app" ] || continue
    apppath="/Applications/${app##*/}"
    [ -e "$apppath" ] || continue
    xattr -p com.apple.quarantine "$apppath" >/dev/null 2>&1 || continue
    xattr -dr com.apple.quarantine "$apppath" || return
  done <<<"$apps"
}

function __f5_update_macos() {
  __f5_step brew update
  __f5_step brew bundle --file "$__F5_BREWFILE"
  __f5_step brew bundle cleanup --force --zap --file "$__F5_BREWFILE"
  __f5_step brew upgrade --greedy
  __f5_step_if jq __f5_strip_tap_quarantine
  __f5_step_if mas sudo mas update
  __f5_step __macos_post_install_cleanup
}

function __f5_has_controller_modules() {
  __cmd_exists dkms && dkms status | grep -qiE 'xpadneo|xone'
}

function __f5_update_linux() {
  __f5_step sudo apt update
  __f5_step sudo apt dist-upgrade -y
  __f5_step sudo apt autoremove -y
  __f5_step sudo apt clean
  __f5_has_controller_modules && __f5_step sudo dkms autoinstall
  __f5_step_if cargo cargo install --locked difftastic
  [ -d "$HOME/.local/share/fonts/NerdFonts" ] && __f5_step __f5_update_nerd_fonts
  __f5_step_if flatpak flatpak update -y --noninteractive
  [ -d "$HOME/.steam/steam/compatibilitytools.d" ] && __f5_step __f5_update_proton_ge
  return 0
}

function __f5_update_nerd_fonts() {
  local fonts_dir="$HOME/.local/share/fonts/NerdFonts"
  local base="https://github.com/ryanoasis/nerd-fonts/releases/latest/download"
  local font result=0

  for font in FiraCode FiraMono Hack JetBrainsMono UbuntuMono Ubuntu UbuntuSans; do
    curl -fsSL --connect-timeout 10 --max-time 120 "${base}/${font}.tar.xz" |
      tar -xJf - -C "$fonts_dir" || result=1
  done
  __cmd_exists fc-cache && fc-cache -f "$fonts_dir"
  return "$result"
}

function __f5_update_proton_ge() {
  local proton_dir="$HOME/.steam/steam/compatibilitytools.d"
  local latest arch asset

  latest="$(curl -fsSL --connect-timeout 10 --max-time 30 \
    https://api.github.com/repos/GloriousEggroll/proton-ge-custom/releases/latest |
    grep '"tag_name"' | cut -d '"' -f 4)"
  [ -n "$latest" ] || return 1

  arch="$(uname -m)"
  [ "$arch" = "arm64" ] && arch="aarch64"
  asset="${latest}-${arch}"
  [ -d "$proton_dir/$asset" ] || [ -d "$proton_dir/$latest" ] && return 0
  __f5_install_proton_ge "$proton_dir" "$latest" "$asset"
}

function __f5_install_proton_ge() {
  local proton_dir="$1"
  local tag="$2"
  local asset="$3"
  local base="https://github.com/GloriousEggroll/proton-ge-custom/releases/download/${tag}"
  local work result=1

  work="$(mktemp -d)" || return 1
  if curl -fSL --connect-timeout 10 --max-time 900 -o "$work/$asset.tar.gz" "$base/$asset.tar.gz" &&
    curl -fsSL --connect-timeout 10 --max-time 30 -o "$work/$asset.sha512sum" "$base/$asset.sha512sum" &&
    (cd "$work" && sha512sum -c "$asset.sha512sum") &&
    tar -xzf "$work/$asset.tar.gz" -C "$proton_dir"; then
    result=0
  fi
  rm -rf "${work:?}"
  return "$result"
}

function __f5_uvfile_names() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "" | \#*) continue ;;
      *) printf '%s\n' "${line%%\[*}" ;;
    esac
  done <"$__F5_UVFILE"
}

function __f5_uv_installed() {
  uv tool list 2>/dev/null | awk '/^[^-[:space:]]/ {print $1}'
}

function __f5_sync_uv_tools() {
  local wanted installed line result=0

  wanted="$(__f5_uvfile_names)"
  installed="$(__f5_uv_installed)"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "" | \#*) continue ;; esac
    printf '%s\n' "$installed" | grep -Fqx "${line%%\[*}" && continue
    uv tool install "$line" || result=1
  done <"$__F5_UVFILE"
  uv tool upgrade --all || result=1
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '%s\n' "$wanted" | grep -Fqx "$line" || uv tool uninstall "$line" || result=1
  done <<<"$installed"
  return "$result"
}

function __f5_update_python() {
  __cmd_exists uv || return 0
  [ -f "$__F5_UVFILE" ] && __f5_step __f5_sync_uv_tools
  __f5_step_if python3 uv pip install --system --python python3 --upgrade pdbp ipdb
}

function __f5_clean_brew() {
  local cache
  cache="$(brew --cache)" || return
  brew cleanup -s --prune=all || return
  command rm -rf "${cache:?}"
}

function __f5_clean_uv() {
  pgrep -x uv >/dev/null && return 0
  UV_LOCK_TIMEOUT=15 uv cache prune
}

function __f5_clean_caches() {
  __f5_step_if brew __f5_clean_brew
  __f5_step_if npm npm cache verify
  __f5_step_if pnpm pnpm store prune
  __f5_step_if yarn yarn cache clean
  __f5_step_if uv __f5_clean_uv
  __f5_step_if go go clean -cache
  [ "$(uname)" = "Darwin" ] || return 0
  __f5_step_if pod pod cache clean --all
  [ -d "$HOME/Library/Developer/Xcode/DerivedData" ] &&
    __f5_step command rm -rf "$HOME/Library/Developer/Xcode/DerivedData"
  __f5_step_if xcrun xcrun simctl delete unavailable
}

function __f5_reload() {
  command rm -rf "${__EVAL_CACHE_DIR:?}"
  [ -n "${TMUX:-}" ] || return 0
  __f5_step_if tmux tmux source-file "$HOME/.dotfiles/tmux/.tmux.conf"
}

function f5() {
  setopt local_options local_traps
  local __f5_failed=0

  __f5_sudo_begin || {
    __stop f5 "root access was not granted"
    return 1
  }
  trap '__f5_sudo_end' EXIT
  # shellcheck disable=SC2329
  TRAPINT() { __f5_sudo_end; return $((128 + $1)); }
  # shellcheck disable=SC2329
  TRAPTERM() { __f5_sudo_end; return $((128 + $1)); }

  __f5_update_repos
  __f5_update_plugins
  __f5_update_editors
  __f5_update_runtimes
  case "$(uname)" in
    Darwin) __f5_update_macos ;;
    Linux) __f5_update_linux ;;
  esac
  __f5_update_python
  __f5_clean_caches
  __f5_reload
  return "$__f5_failed"
}
