#!/usr/bin/env bash

export ZSH_DISABLE_COMPFIX=true
export HOMEBREW_NO_ANALYTICS=true
export HOMEBREW_NO_ENV_HINTS=true
export HOMEBREW_NO_AUTO_UPDATE=true
export HOMEBREW_NO_ASK=true

setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_VERIFY
setopt GLOB_DOTS
export HISTORY_IGNORE="(cd|ls|[bf]g|clear|exit)"
export HISTSIZE=2147483647
export SAVEHIST=2147483647
export LANG=en_US.UTF-8
export JIMAKU_LANGUAGE=pt-BR
export REPORTTIME=5
export COLORTERM=truecolor
export CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=1

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

if [ "$(ulimit -n)" -lt 10240 ] 2>/dev/null; then
  ulimit -n 10240 2>/dev/null || true
fi

export PYTHONSTARTUP="$HOME/.dotfiles/python/pythonrc"
export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$HOME/.dotfiles/python"
export PYTHONBREAKPOINT="debughook.set_trace"
export NODE_REPL_HISTORY="$HOME/.node_repl_history"
export NODE_REPL_HISTORY_SIZE=10000
export NODE_REPL_MODE=sloppy
export NODE_OPTIONS="--enable-source-maps --stack-trace-limit=50"

__EVAL_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/eval-cache"

function __eval_cache_path_sum() {
  [ -n "${__EVAL_CACHE_PATH_SUM:-}" ] && return 0
  __EVAL_CACHE_PATH_SUM="$(printf '%s' "$PATH" | command cksum | command awk '{print $1}')"
}

function __cached_eval() {
  local cmd="$1"
  shift
  local bin_path mtime cache_file init_output

  bin_path="$(command -v "$cmd" 2>/dev/null)" || return 0
  mtime="$(command stat -c '%Y' "$bin_path" 2>/dev/null || command stat -f '%m' "$bin_path" 2>/dev/null)" || return 0
  __eval_cache_path_sum
  cache_file="${__EVAL_CACHE_DIR}/${cmd}--${mtime}--${__EVAL_CACHE_PATH_SUM}"

  if [ ! -f "$cache_file" ]; then
    setopt local_options null_glob
    command mkdir -p "$__EVAL_CACHE_DIR"
    command rm -f "${__EVAL_CACHE_DIR}/${cmd}--"*
    init_output="$("$bin_path" "$@")" || {
      __error "$cmd" "init failed, so it is not loaded in this shell."
      return 0
    }
    printf '%s' "$init_output" >"$cache_file"
  fi
  # shellcheck disable=SC1090
  source "$cache_file"
}

function eval-cache-clear() {
  command rm -rf "${__EVAL_CACHE_DIR:?}"
}

export FZF_DEFAULT_OPTS=" \
  --layout=reverse --border=rounded \
  --preview 'bat --color=always --style=numbers --line-range=:500 {} 2>/dev/null || cat {}' \
  --bind 'ctrl-/:toggle-preview' \
  --bind 'ctrl-d:preview-half-page-down' \
  --bind 'ctrl-u:preview-half-page-up' \
  --bind 'ctrl-o:execute(\${EDITOR:-vim} {})'"

if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND="fd --type f --hidden --follow --exclude .git"
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
fi

export ZSH="$HOME/.oh-my-zsh"
export ZSH_THEME="spaceship"
export DISABLE_AUTO_UPDATE="true"
export HIST_STAMPS="yyyy-mm-dd"
export DISABLE_MAGIC_FUNCTIONS=true
export DISABLE_AUTO_TITLE=true
export ZSH_COMPDUMP="${ZSH_CACHE_DIR:-$HOME/.cache}/.zcompdump-${HOST}-${ZSH_VERSION}"

zstyle :omz:plugins:ssh-agent identities id_ed25519_personal id_ed25519_onyx

zstyle :omz:plugins:ssh-agent ssh-add-args --apple-use-keychain

export plugins=(
  gpg-agent
  ssh-agent
  extract
  fzf
  fzf-tab
  zsh-autosuggestions
  zsh-syntax-highlighting
)

export ZSH_AUTOSUGGEST_STRATEGY=(history completion)

export SPACESHIP_USER_SHOW=always
export SPACESHIP_PROMPT_ADD_NEWLINE=false
export SPACESHIP_CHAR_SYMBOL=$'\u276f'
export SPACESHIP_CHAR_SUFFIX=" "
export SPACESHIP_GCLOUD_SHOW=false

function __token_cache_is_fresh() {
  local cache_file="$1"
  local max_age="${DOTFILES_TOKEN_CACHE_MAX_AGE:-86400}"
  local cached_at

  [ -f "$cache_file" ] || return 1
  cached_at="$(command stat -c '%Y' "$cache_file" 2>/dev/null || command stat -f '%m' "$cache_file" 2>/dev/null)" || return 1
  [ -n "$cached_at" ] || return 1
  [ "$(($(date +%s) - cached_at))" -lt "$max_age" ]
}

function __decrypt_token() {
  local gpg_file="$1"
  local cache_file="$2"

  command -v gpg >/dev/null 2>&1 || return 1
  [ -f "$gpg_file" ] || return 1
  (umask 077 && gpg --quiet --batch --yes -d "$gpg_file" 2>/dev/null | tr -d '\n' >"$cache_file") || {
    rm -f "$cache_file"
    return 1
  }
}

function __update_token() {
  local env_var_name="$1"
  local gpg_file="$2"
  local cache_dir="$HOME/.cache/dotfiles-tokens"
  local cache_file="${cache_dir}/$3.cache"
  local token_content

  mkdir -p "$cache_dir" && chmod 700 "$cache_dir"
  __token_cache_is_fresh "$cache_file" || __decrypt_token "$gpg_file" "$cache_file" || return 1
  token_content="$(tr -d '\n' <"$cache_file")"
  if [ -z "$token_content" ]; then
    rm -f "$cache_file"
    return 1
  fi
  export "${env_var_name}"="$token_content"
}

[ -n "$NPM_TOKEN" ] || __update_token NPM_TOKEN "$HOME/.dotfiles/nodejs/tokens/npm.gpg" npm_token
[ -n "$GITHUB_PAT" ] || __update_token GITHUB_PAT "$HOME/.dotfiles/git/tokens/github.gpg" github_token

if [ ! -e "$HOME/Workspace" ] && [ -d "$HOME/Dropbox/Workspace" ]; then
  ln -s "$HOME/Dropbox/Workspace" "$HOME/Workspace"
fi

if [ -d "$HOME/second-brain" ]; then
  export SECOND_BRAIN_VAULT="$HOME/second-brain"
fi
