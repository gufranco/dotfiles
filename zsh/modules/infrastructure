#!/usr/bin/env bash

__DOCKER_SERVICES=(mongo postgres redis valkey redict ubuntu)

function __clamp_resource() {
  local value="$1"
  local minimum="$2"
  local maximum="$3"
  local total="$4"

  if [ "$value" -gt "$maximum" ]; then
    echo "$maximum"
  elif [ "$value" -ge "$minimum" ]; then
    echo "$value"
  elif [ "$total" -ge "$minimum" ]; then
    echo "$minimum"
  else
    echo "$total"
  fi
}

function __round_to_power_of_2() {
  local value="$1"
  local rounded=1
  while [ "$rounded" -lt "$value" ]; do
    rounded=$((rounded * 2))
  done
  echo "$rounded"
}

function __calculate_vm_cores() {
  local total result
  case "$(uname -s)" in
    Darwin) total="$(sysctl -n hw.ncpu)" ;;
    Linux) total="$(nproc)" ;;
  esac
  result=$((total * 50 / 100))
  [ "$result" -ge 2 ] && [ $((result % 2)) -ne 0 ] && result=$((result + 1))
  __clamp_resource "$result" 2 4 "$total"
}

function __calculate_vm_memory() {
  local total
  case "$(uname -s)" in
    Darwin) total=$(($(sysctl -n hw.memsize) / 1024 / 1024 / 1024)) ;;
    Linux) total=$(($(awk '/MemTotal/ {print $2}' /proc/meminfo) / 1024 / 1024)) ;;
  esac
  __clamp_resource "$(__round_to_power_of_2 $((total * 50 / 100)))" 2 8 "$total"
}

function __calculate_vm_storage() {
  local bytes total
  case "$(uname -s)" in
    Darwin) bytes="$(diskutil info /dev/disk0 | awk -F'[()]' '/Disk Size/ {sub(/ Bytes/, "", $2); print $2}')" ;;
    Linux) bytes="$(lsblk -bdno SIZE "/dev/$(lsblk -no pkname "$(df / --output=source | tail -n1)")")" ;;
  esac
  total=$(((bytes / 1073741824 + 255) / 256 * 256))
  __clamp_resource "$(__round_to_power_of_2 $((total * 25 / 100)))" 8 64 "$total"
}

function __ensure_docker_compose_plugin() {
  __cmd_exists docker-compose || return 0
  __safe_link "$(command -v docker-compose)" "${HOME}/.docker/cli-plugins/docker-compose"
}

function __confirm_typed() {
  local name="$1"
  local expected="$2"
  local action="$3"
  local answer

  [ "${CI:-0}" = 1 ] && return 0
  if [ ! -t 0 ]; then
    __stop "$name" "no terminal to confirm on"
    return 1
  fi
  printf 'Type %s to %s, or anything else to stop: ' "$expected" "$action" >&2
  read -r answer
  [ "$answer" = "$expected" ] && return 0
  __stop "$name" "nothing was changed"
  return 1
}

function __confirm_yes() {
  local name="$1"
  local question="$2"
  local answer

  [ "${CI:-0}" = 1 ] && return 0
  if [ ! -t 0 ]; then
    __stop "$name" "no terminal to confirm on"
    return 1
  fi
  printf '%s [y/N]: ' "$question" >&2
  read -r answer
  case "$answer" in
    y | Y | yes) return 0 ;;
    *)
      __stop "$name" "nothing was changed"
      return 1
      ;;
  esac
}

function __docker_container_start() { command docker start "$1"; }
function __docker_container_stop() { command docker stop "$1"; }

function __capitalize() {
  printf '%s%s\n' "$(printf '%s' "${1:0:1}" | tr '[:lower:]' '[:upper:]')" "${1:1}"
}

function __docker_container_purge() {
  local container_name="$1"
  local data_dir
  data_dir="$HOME/Docker/$(__capitalize "$container_name")"

  command docker stop "$container_name"
  command docker rm "$container_name"
  rm -rf "${data_dir:?}"
}

function __docker_container_terminal() {
  command docker exec -it "$1" "${2:-/bin/sh}"
}

function __docker_run_detached() {
  local container_name="$1"
  local data_dir
  shift
  data_dir="$HOME/Docker/$(__capitalize "$container_name")"
  mkdir -p "$data_dir"
  command docker run --detach --hostname "$container_name" --name "$container_name" \
    --restart unless-stopped --log-driver local --log-opt max-size=10m --log-opt max-file=3 \
    --mount "type=bind,source=${data_dir},target=/external" "$@"
}

# shellcheck disable=SC2004,SC2034,SC2154
function __docker_define_services() {
  local service shell
  for service in "${__DOCKER_SERVICES[@]}"; do
    shell="/bin/sh"
    [ "$service" = ubuntu ] && shell="/bin/bash"
    functions[${service}-start]="__docker_container_start ${service}"
    functions[${service}-stop]="__docker_container_stop ${service}"
    functions[${service}-purge]="__docker_container_purge ${service}"
    functions[${service}-terminal]="__docker_container_terminal ${service} ${shell}"
  done
}

function mongo-init() {
  __docker_run_detached mongo \
    --env MONGO_INITDB_ROOT_USERNAME=mongo --env MONGO_INITDB_ROOT_PASSWORD=mongo \
    --volume mongo-data:/data/db --volume mongo-config:/data/configdb \
    --publish 127.0.0.1:27017:27017 \
    --health-cmd "mongosh --eval 'db.adminCommand({ping: 1})' --quiet" \
    --health-interval 30s --health-timeout 10s --health-retries 3 \
    mongo:latest
}

function postgres-init() {
  __docker_run_detached postgres \
    --env POSTGRES_USER=postgres --env POSTGRES_PASSWORD=postgres \
    --volume postgres-data:/var/lib/postgresql/data \
    --publish 127.0.0.1:5432:5432 \
    --health-cmd "pg_isready -U postgres" \
    --health-interval 30s --health-timeout 10s --health-retries 3 \
    postgres:alpine
}

function redis-init() {
  __docker_run_detached redis \
    --volume redis-data:/data --publish 127.0.0.1:6379:6379 \
    --health-cmd "redis-cli ping" --health-interval 30s --health-timeout 10s --health-retries 3 \
    redis:alpine redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
}

function valkey-init() {
  __docker_run_detached valkey \
    --volume valkey-data:/data --publish 127.0.0.1:7000:7000 \
    --health-cmd "valkey-cli -p 7000 ping" --health-interval 30s --health-timeout 10s --health-retries 3 \
    valkey/valkey:alpine valkey-server --port 7000 --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
}

function redict-init() {
  __docker_run_detached redict \
    --volume redict-data:/data --publish 127.0.0.1:6379:6379 \
    --health-cmd "redict-cli ping" --health-interval 30s --health-timeout 10s --health-retries 3 \
    registry.redict.io/redict:alpine redict-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
}

function ubuntu-init() {
  __docker_run_detached ubuntu --volume ubuntu-data:/data ubuntu:24.04
}

function __colima_help() {
  cat <<'HELP'
colima-start - start a Colima VM sized from this machine, with Docker inside

usage:
  colima-start [options] [profile]    start the VM, profile default by default
  colima-start help                   print this page

options:
  --cores <n>      CPUs, default half the machine's, between 2 and 4
  --memory <gib>   memory, default half the machine's, between 2 and 8
  --storage <gib>  disk, default a quarter of the system disk, between 8 and 64

notes:
  On Apple Silicon it uses Apple's Virtualization.framework with Rosetta 2
  for x86_64 images; on Intel Macs, the same framework; on Linux, QEMU with
  KVM. Home is mounted read-write and DNS is 1.1.1.1 and 8.8.8.8.
  colima-stop [profile] stops it; colima-purge [profile] deletes it and
  every image, volume and container in it.

examples:
  colima-start
  colima-start --cores 4 --memory 8 work
HELP
}

function __colima_vm_args() {
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64) arch="aarch64" vm_args=(--vm-type vz --vz-rosetta --mount-type virtiofs) ;;
    Darwin/x86_64) arch="x86_64" vm_args=(--vm-type vz --mount-type virtiofs) ;;
    Linux/*) arch="x86_64" vm_args=(--vm-type qemu --mount-type 9p) ;;
  esac
}

function colima-start() {
  local profile="default" cores="" memory="" storage="" arch
  local -a vm_args

  while [ $# -gt 0 ]; do
    case "$1" in
      help | -h | --help) __colima_help; return 0 ;;
      --cores | --memory | --storage)
        [ $# -ge 2 ] || { __usage_error colima-start "option '$1' needs a value"; return 1; }
        case "$1" in --cores) cores="$2" ;; --memory) memory="$2" ;; --storage) storage="$2" ;; esac
        shift
        ;;
      -*) __usage_error colima-start "unknown option '$1'"; return 1 ;;
      *) profile="$1" ;;
    esac
    shift
  done
  __colima_vm_args
  : "${cores:=$(__calculate_vm_cores)}" "${memory:=$(__calculate_vm_memory)}" "${storage:=$(__calculate_vm_storage)}"
  __confirm_yes colima-start "Start the ${profile} VM with ${cores} CPUs, ${memory} GiB of memory and a ${storage} GiB disk?" || return 1
  __ensure_docker_compose_plugin
  command colima start --profile "$profile" --cpu "$cores" --memory "$memory" --disk "$storage" \
    --runtime docker --arch "$arch" --mount "$HOME:w" --mount-inotify --dns 1.1.1.1 --dns 8.8.8.8 \
    --network-address --activate --env DOCKER_BUILDKIT=1 --env COMPOSE_DOCKER_CLI_BUILD=1 \
    --env BUILDKIT_INLINE_CACHE=1 "${vm_args[@]}"
}

function colima-stop() {
  command colima stop --profile "${1:-default}"
}

function __docker_purge_context() {
  local profile="${1:-default}"
  local context="colima-${profile}"
  local ids

  [ "$profile" = default ] && context="colima"
  ids="$(DOCKER_CONTEXT="$context" command docker ps -aq)"
  [ -n "$ids" ] && printf '%s\n' "$ids" | DOCKER_CONTEXT="$context" xargs docker stop
  DOCKER_CONTEXT="$context" command docker system prune -af --volumes --filter "label!=keep"
  DOCKER_CONTEXT="$context" command docker builder prune -af
}

function docker-purge() {
  local profile="${1:-default}"
  case "$profile" in
    help | -h | --help)
      __say "docker-purge [profile] removes every container, image, volume and build cache in a Colima profile."
      return 0
      ;;
  esac
  __confirm_typed docker-purge "$profile" "remove everything Docker holds in it" || return 1
  __docker_purge_context "$profile"
}

function __colima_remove_orphans() {
  setopt local_options null_glob
  local disks_dir="$HOME/.colima/_lima/_disks"
  local listing dir disk profile

  listing="$(command colima list)" || {
    __warn colima-purge "colima list failed, so orphan disks are left in place."
    return 0
  }
  for dir in "$disks_dir"/colima*/; do
    dir="${dir%/}"
    disk="${dir##*/}"
    profile="${disk#colima-}"
    [ "$disk" = colima ] && profile="default"
    printf '%s\n' "$listing" | awk 'NR > 1 {print $1}' | grep -Fqx "$profile" && continue
    rm -rf "${dir:?}" "${HOME:?}/.colima/_lima/${disk:?}"
  done
}

function colima-purge() {
  local profile="${1:-default}"
  case "$profile" in
    help | -h | --help)
      __say "colima-purge [profile] deletes a Colima VM with every image, volume and container in it."
      return 0
      ;;
  esac
  __confirm_typed colima-purge "$profile" "delete the VM and everything in it" || return 1
  __docker_purge_context "$profile"
  command colima stop --profile "$profile" --force
  command colima delete --profile "$profile" --force
  __colima_remove_orphans
  command colima prune --all --force
}

if command -v fzf >/dev/null && command -v docker >/dev/null; then
  function __docker_pick_container() {
    command docker ps --format '{{.ID}} {{.Names}} {{.Image}}' | fzf "$@" | awk '{ print $1 }'
  }

  function fde() {
    local cid
    cid="$(__docker_pick_container --header='open a shell in a container')"
    [ -n "$cid" ] || return
    command docker exec -it "$cid" sh -c 'if command -v bash >/dev/null 2>&1; then exec bash; else exec sh; fi'
  }

  function fdl() {
    local cid
    cid="$(__docker_pick_container --header='follow the logs of a container')"
    [ -n "$cid" ] || return
    command docker logs -f --tail 200 "$cid"
  }

  function fds() {
    local cids
    cids="$(__docker_pick_container -m --header='stop containers')"
    [ -n "$cids" ] || return
    printf '%s\n' "$cids" | xargs docker stop
  }
fi

__docker_define_services
