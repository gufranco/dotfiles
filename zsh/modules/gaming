#!/usr/bin/env bash

if [[ "$(uname)" != "Linux" ]] || [[ "$(dpkg --print-architecture 2>/dev/null)" != "amd64" ]]; then
  # shellcheck disable=SC2317
  return 0 2>/dev/null || true
fi

function __gaming_row() {
  printf '%-18s %-8s %s\n' "$1" "$2" "$3"
}

function __gaming_require() {
  local name="$1"
  local tool="$2"
  local detail="$3"

  if __cmd_exists "$tool"; then
    __gaming_row "$name" ok "${detail:-$(command -v "$tool")}"
    return 0
  fi
  __gaming_row "$name" missing "install ${tool}"
  return 1
}

function __gaming_expect() {
  local name="$1"
  local actual="$2"
  local wanted="$3"

  if [ "$actual" = "$wanted" ]; then
    __gaming_row "$name" ok "$actual"
  else
    __gaming_row "$name" warn "${actual:-unknown}, expected ${wanted}"
  fi
}

function __gaming_check_gpu() {
  local result=0 driver gpus

  driver="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1)"
  __gaming_require nvidia-driver nvidia-smi "${driver:+driver ${driver}}" || result=1
  __gaming_require nvidia-prime prime-select "$(prime-select query 2>/dev/null)" || result=1
  gpus="$(vulkaninfo --summary 2>/dev/null | awk -F'= ' '/deviceName/ {print $2}' | paste -sd, -)"
  __gaming_require vulkan vulkaninfo "${gpus:-no GPU found}" || result=1
  if dpkg -l 2>/dev/null | grep -q "^ii  nvidia-driver-[0-9]*-open"; then
    __gaming_row nvidia-modules ok "open kernel modules"
  else
    __gaming_row nvidia-modules warn "proprietary, expected on pre-Turing MX chips"
  fi
  if grep -q "PreserveVideoMemoryAllocations=1" /etc/modprobe.d/nvidia-power.conf 2>/dev/null; then
    __gaming_row nvidia-suspend ok "video memory kept across suspend"
  else
    __gaming_row nvidia-suspend warn "add /etc/modprobe.d/nvidia-power.conf"
  fi
  return "$result"
}

function __gaming_check_tools() {
  local result=0 proton_dir="$HOME/.steam/steam/compatibilitytools.d" latest

  if gamemoded -t 2>/dev/null | grep -q "gamemode request succeeded"; then
    __gaming_row gamemode ok "functional"
  else
    __gaming_require gamemode gamemoded "installed, but its self-test failed; check group membership" || result=1
  fi
  __gaming_require mangohud mangohud || result=1
  __gaming_require gamescope gamescope || result=1
  __gaming_require steam steam || result=1
  latest="$(command ls -1 "$proton_dir" 2>/dev/null | sort -V | tail -1)"
  if [ -n "$latest" ]; then
    __gaming_row ge-proton ok "$latest"
  else
    __gaming_row ge-proton missing "run f5 to download it"
    result=1
  fi
  return "$result"
}

function __gaming_check_system() {
  __gaming_expect vm.max_map_count "$(command sysctl -n vm.max_map_count 2>/dev/null)" 2147483642
  __gaming_expect split_lock "$(command sysctl -n kernel.split_lock_mitigate 2>/dev/null)" 0
  __gaming_expect vm.swappiness "$(command sysctl -n vm.swappiness 2>/dev/null)" 180
  if command uname -r | grep -qi xanmod; then
    __gaming_row kernel ok "$(command uname -r)"
  else
    __gaming_row kernel warn "$(command uname -r), XanMod not booted; reboot"
  fi
  __gaming_expect scx "$(command systemctl is-active scx.service 2>/dev/null)" active
  __gaming_expect earlyoom "$(command systemctl is-active earlyoom 2>/dev/null)" active
  if command swapon --show 2>/dev/null | grep -q zram; then
    __gaming_row zram ok "active"
  else
    __gaming_row zram warn "not active"
  fi
  __gaming_check_files
}

function __gaming_check_files() {
  setopt local_options null_glob
  local -a rules=(/lib/udev/rules.d/*steam* /usr/lib/udev/rules.d/*steam*)

  if [ "${#rules[@]}" -gt 0 ]; then
    __gaming_row steam-udev ok "controller rules present"
  else
    __gaming_row steam-udev warn "no controller rules; start Steam once"
  fi
  if [ -L "$HOME/.config/gamemode.ini" ]; then
    __gaming_row gamemode.ini ok "linked"
  else
    __gaming_row gamemode.ini warn "not linked; run install.sh"
  fi
}

function gaming-check() {
  case "${1:-}" in
    help | -h | --help)
      __say "gaming-check prints one row per gaming component: ok, missing or warn. It returns 1 only when a required component is missing."
      return 0
      ;;
    "") ;;
    *) __usage_error gaming-check "unknown argument '$1'"; return 1 ;;
  esac
  local result=0
  __gaming_check_gpu || result=1
  __gaming_check_tools || result=1
  __gaming_check_system
  return "$result"
}

function gaming-launch-options() {
  cat <<'OPTIONS'
Paste one of these into a game's Properties, then Launch Options, in Steam.

Most games:
  prime-run gamemoderun mangohud %command%

Render below native and let Gamescope upscale with FSR and cap the frame rate:
  prime-run gamescope -W 1920 -H 1080 -w 1280 -h 720 -F fsr --sharpness 5 -r 60 --adaptive-sync --mangoapp -- gamemoderun %command%

CAS sharpening only, no upscale:
  prime-run ENABLE_VKBASALT=1 gamemoderun mangohud %command%

Write Proton logs to /tmp:
  prime-run PROTON_LOG=1 gamemoderun %command%
OPTIONS
}
