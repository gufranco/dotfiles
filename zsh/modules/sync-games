function __sync_games_help() {
  cat <<'HELP'
sync_games - mirror the game library from the Internet Archive and OSSC firmware

usage:
  sync_games         sync into the current directory
  sync_games help    print this page

notes:
  Each collection goes to "Internet Archive/<system>/<item>" under the
  current directory, and the OSSC firmware to OSSC. rclone deletes local
  files the source no longer has, after moving them into
  .sync-games-trash/<date>/, and prints its own progress.
  Collections that are paused, and not synced:
HELP
  printf '    %s\n' "${__SYNC_GAMES_PAUSED[@]}"
}

function __sync_games_rclone() {
  local folder="$1"
  shift
  mkdir -p "./$folder/"
  rclone sync --progress --ignore-case --size-only --delete-excluded \
    --backup-dir "./.sync-games-trash/$(date +%Y-%m-%d)/$folder" \
    --retries 3 --retries-sleep 10s --low-level-retries 10 \
    "$@" "./$folder/"
}

function __sync_games_archive() {
  local failed=0 entry system item

  for entry in "${__SYNC_GAMES_COLLECTIONS[@]}"; do
    system="${entry%%|*}"
    item="${entry#*|}"
    __sync_games_rclone "Internet Archive/$system/$item" --multi-thread-streams=4 \
      --exclude "$__SYNC_GAMES_EXCLUDE" ":internetarchive:$item/" || {
      __warn sync_games "${system}/${item} did not sync."
      failed=$((failed + 1))
    }
  done
  return "$failed"
}

function sync_games() {
  local failed=0

  case "${1:-}" in
    help | -h | --help) __sync_games_help; return 0 ;;
    "") ;;
    *) __usage_error sync_games "unknown argument '$1'"; return 1 ;;
  esac
  if ! __cmd_exists rclone; then
    __error sync_games "rclone is not installed."
    return 1
  fi
  __sync_games_rclone OSSC --multi-thread-streams=0 --exclude "*.{jic,txt}" \
    --http-url "http://www.infocult.com/m/ossc/fw/v1-series/" ":http:" || {
    __warn sync_games "the OSSC firmware did not sync."
    failed=1
  }
  __sync_games_archive || failed=1
  [ "$failed" -eq 0 ]
}
